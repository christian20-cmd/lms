name: LMS
description: LMS Mobile Application
version: 1.0.0+1

environment:
  sdk: '^3.11.0'

dependencies:
  flutter:
    sdk: flutter

  # Navigation
  go_router: ^14.0.0
  app_links: ^6.1.1

  # State management
  flutter_riverpod: ^2.5.1

  # URL launcher
  url_launcher: ^6.3.1

  # HTTP
  dio: ^5.4.3+1

  # Storage local
  flutter_secure_storage: ^9.2.2
  shared_preferences: ^2.2.3

  # UI
  cached_network_image: ^3.3.1
  flutter_svg: ^2.0.10+1
  shimmer: ^3.0.0
  fluttertoast: ^8.2.8

  # Video player
  video_player: ^2.8.6
  chewie: ^1.8.1

  # File / Document viewer
  flutter_pdfview: ^1.3.2
  open_filex: ^4.3.4
  file_picker: ^8.0.0

  # Image picker
  image_picker: ^1.1.2

  # Fonts
  google_fonts: ^6.2.1

  # Utils
  intl: ^0.19.0
  connectivity_plus: ^6.0.3
  fl_chart: ^0.70.2

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^4.0.0
  flutter_launcher_icons: ^0.14.3
  flutter_native_splash: ^2.4.6

flutter:
  uses-material-design: true
  assets:
    - assets/bgt.png
flutter_icons:
  android: true
  image_path: "assets/bgw.png"