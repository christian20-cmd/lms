import 'package:flutter_riverpod/flutter_riverpod.dart';
import '../../data/cours_remote_datasource.dart';
import 'package:LMS/features/auth/presentation/providers/auth_provider.dart';

// ── Datasource ──
final coursDatasourceProvider = Provider((ref) {
  return CoursRemoteDatasource(ref.read(dioProvider));
});

// ── Mes cours ──
final mesCoursProvider = FutureProvider<List<dynamic>>((ref) async {
  return ref.read(coursDatasourceProvider).getMesCours();
});

// ── Catégories ──
final categoriesProvider = FutureProvider<List<dynamic>>((ref) async {
  return ref.read(coursDatasourceProvider).getCategories();
});

// ── Modules d'un cours ──
final modulesProvider =
    FutureProvider.family<List<dynamic>, String>((ref, idCours) async {
  return ref.read(coursDatasourceProvider).getModules(idCours);
});

// ── Contenus d'un module ──
final contenusProvider = FutureProvider.family<List<dynamic>,
    ({String idCours, String idModule})>((ref, params) async {
  return ref.read(coursDatasourceProvider).getContenus(
        idCours: params.idCours,
        idModule: params.idModule,
      );
});

// ── Filtre statut local ──
// 'tous' | 'PUBLIE' | 'BROUILLON'
final filtreStatutProvider = StateProvider<String>((ref) => 'tous');

// ── Filtre recherche local ──
final rechercheCoursProvider = StateProvider<String>((ref) => '');

// ── Cours filtrés (dérivé) ──
final coursFiltresProvider = Provider<List<dynamic>>((ref) {
  final coursAsync = ref.watch(mesCoursProvider);
  final filtre = ref.watch(filtreStatutProvider);
  final recherche = ref.watch(rechercheCoursProvider).toLowerCase().trim();

  return coursAsync.maybeWhen(
    data: (cours) {
      var liste = cours;

      if (filtre != 'tous') {
        liste = liste
            .where((c) => c['statutCours'] == filtre)
            .toList();
      }

      if (recherche.isNotEmpty) {
        liste = liste
            .where((c) => (c['titreCours'] as String)
                .toLowerCase()
                .contains(recherche))
            .toList();
      }

      return liste;
    },
    orElse: () => [],
  );
});

// ── Actions cours (StateNotifier pour mutations) ──
class CoursNotifier extends StateNotifier<AsyncValue<void>> {
  final CoursRemoteDatasource _datasource;
  final Ref _ref;

  CoursNotifier(this._datasource, this._ref)
      : super(const AsyncValue.data(null));

  Future<void> creerCours({
    required String titreCours,
    required String descriptionCours,
    required String niveauCours,
    required String idCategorie,
    required bool estGratuitCours,
    double? prixCours,
    List<String>? tagsExistants,
    List<String>? nouveauxTags,
    String? imagePath,
  }) async {
    state = const AsyncValue.loading();
    try {
      await _datasource.creerCours(
        titreCours: titreCours,
        descriptionCours: descriptionCours,
        niveauCours: niveauCours,
        idCategorie: idCategorie,
        estGratuitCours: estGratuitCours,
        prixCours: prixCours,
        tagsExistants: tagsExistants,
        nouveauxTags: nouveauxTags,
        imagePath: imagePath,
      );
      _ref.invalidate(mesCoursProvider);
      state = const AsyncValue.data(null);
    } catch (e, st) {
      state = AsyncValue.error(e, st);
      rethrow;
    }
  }

  Future<void> modifierCours({
    required String idCours,
    String? titreCours,
    String? descriptionCours,
    String? niveauCours,
    String? idCategorie,
    bool? estGratuitCours,
    double? prixCours,
    String? imagePath,
  }) async {
    state = const AsyncValue.loading();
    try {
      await _datasource.modifierCours(
        idCours: idCours,
        titreCours: titreCours,
        descriptionCours: descriptionCours,
        niveauCours: niveauCours,
        idCategorie: idCategorie,
        estGratuitCours: estGratuitCours,
        prixCours: prixCours,
        imagePath: imagePath,
      );
      _ref.invalidate(mesCoursProvider);
      state = const AsyncValue.data(null);
    } catch (e, st) {
      state = AsyncValue.error(e, st);
      rethrow;
    }
  }

  Future<void> toggleStatutCours(String idCours) async {
    try {
      await _datasource.toggleStatutCours(idCours);
      _ref.invalidate(mesCoursProvider);
    } catch (e) {
      rethrow;
    }
  }

  Future<void> supprimerCours(String idCours) async {
    try {
      await _datasource.supprimerCours(idCours);
      _ref.invalidate(mesCoursProvider);
    } catch (e) {
      rethrow;
    }
  }

  // ── Catégories (création dynamique depuis le frontend) ──
  Future<Map<String, dynamic>> creerCategorie(String nomCategorie) async {
    try {
      final res = await _datasource.creerCategorie(nomCategorie);
      // Invalider la liste des catégories pour que UI récupère la nouvelle liste
      _ref.invalidate(categoriesProvider);
      return res;
    } catch (e) {
      rethrow;
    }
  }

  // ── Modules ──
  Future<void> creerModule({
    required String idCours,
    required String titreModule,
    required String descriptionModule,
  }) async {
    state = const AsyncValue.loading();
    try {
      await _datasource.creerModule(
        idCours: idCours,
        titreModule: titreModule,
        descriptionModule: descriptionModule,
      );
      _ref.invalidate(modulesProvider(idCours));
      state = const AsyncValue.data(null);
    } catch (e, st) {
      state = AsyncValue.error(e, st);
      rethrow;
    }
  }

  Future<void> modifierModule({
    required String idCours,
    required String idModule,
    String? titreModule,
    String? descriptionModule,
  }) async {
    state = const AsyncValue.loading();
    try {
      await _datasource.modifierModule(
        idCours: idCours,
        idModule: idModule,
        titreModule: titreModule,
        descriptionModule: descriptionModule,
      );
      _ref.invalidate(modulesProvider(idCours));
      state = const AsyncValue.data(null);
    } catch (e, st) {
      state = AsyncValue.error(e, st);
      rethrow;
    }
  }

  Future<void> toggleStatutModule({
    required String idCours,
    required String idModule,
  }) async {
    try {
      await _datasource.toggleStatutModule(
          idCours: idCours, idModule: idModule);
      _ref.invalidate(modulesProvider(idCours));
    } catch (e) {
      rethrow;
    }
  }

  Future<void> supprimerModule({
    required String idCours,
    required String idModule,
  }) async {
    try {
      await _datasource.supprimerModule(
          idCours: idCours, idModule: idModule);
      _ref.invalidate(modulesProvider(idCours));
    } catch (e) {
      rethrow;
    }
  }
}

final coursNotifierProvider =
    StateNotifierProvider<CoursNotifier, AsyncValue<void>>((ref) {
  return CoursNotifier(ref.read(coursDatasourceProvider), ref);
});