                        ),
                      ),
                      child: Text('Gratuit',
                          textAlign: TextAlign.center,
                          style: GoogleFonts.dmSans(
                            fontSize: 13,
                            fontWeight: FontWeight.w500,
                            color: _estGratuit
                                ? _AppColors.statPurpleText
                                : _AppColors.textSecondary,
                          )),
                    ),
                  ),
                ),
                const SizedBox(width: 10),
                Expanded(
                  child: GestureDetector(
