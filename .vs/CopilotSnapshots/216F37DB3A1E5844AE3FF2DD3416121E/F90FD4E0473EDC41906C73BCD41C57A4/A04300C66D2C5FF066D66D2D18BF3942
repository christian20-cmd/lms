class _CoursFormSheet extends ConsumerStatefulWidget {
  final Map<String, dynamic>? coursExistant;
  const _CoursFormSheet({this.coursExistant});

  @override
  ConsumerState<_CoursFormSheet> createState() => _CoursFormSheetState();
}

class _CoursFormSheetState extends ConsumerState<_CoursFormSheet> {
  final _titreCtrl = TextEditingController();
  final _descCtrl = TextEditingController();
  final _prixCtrl = TextEditingController();

  String _niveau = 'DEBUTANT';
  bool _estGratuit = true;
  String? _idCategorie;
  bool _loading = false;
  String? _erreur;

  final _niveaux = ['DEBUTANT', 'INTERMEDIAIRE', 'AVANCE'];

  @override
  void initState() {
    super.initState();
    if (widget.coursExistant != null) {
      final c = widget.coursExistant!;
      _titreCtrl.text = c['titreCours'] ?? '';
      _descCtrl.text = c['descriptionCours'] ?? '';
      _niveau = c['niveauCours'] ?? 'DEBUTANT';
      _estGratuit = c['estGratuitCours'] ?? true;
      _idCategorie = c['idCategorie'];
      if (c['prixCours'] != null) {
        _prixCtrl.text = c['prixCours'].toString();
      }
    }
  }

  @override
  void dispose() {
    _titreCtrl.dispose();
    _descCtrl.dispose();
    _prixCtrl.dispose();
    super.dispose();
  }

  bool get _isModification => widget.coursExistant != null;

  Future<void> _submit() async {
    if (_titreCtrl.text.trim().isEmpty) {
      setState(() => _erreur = 'Le titre est obligatoire');
      return;
    }
    if (_descCtrl.text.trim().isEmpty) {
      setState(() => _erreur = 'La description est obligatoire');
      return;
    }
    if (_idCategorie == null) {
      setState(() => _erreur = 'Veuillez choisir une catégorie');
      return;
    }
    if (!_estGratuit && _prixCtrl.text.trim().isEmpty) {
      setState(() => _erreur = 'Le prix est obligatoire pour un cours payant');
      return;
    }

    setState(() {
      _loading = true;
      _erreur = null;
    });

    try {
      if (_isModification) {
        await ref.read(coursNotifierProvider.notifier).modifierCours(
              idCours: widget.coursExistant!['idCours'],
              titreCours: _titreCtrl.text.trim(),
              descriptionCours: _descCtrl.text.trim(),
              niveauCours: _niveau,
              idCategorie: _idCategorie,
              estGratuitCours: _estGratuit,
              prixCours:
                  _estGratuit ? null : double.tryParse(_prixCtrl.text),
            );
      } else {
        await ref.read(coursNotifierProvider.notifier).creerCours(
              titreCours: _titreCtrl.text.trim(),
              descriptionCours: _descCtrl.text.trim(),
              niveauCours: _niveau,
              idCategorie: _idCategorie!,
              estGratuitCours: _estGratuit,
              prixCours:
                  _estGratuit ? null : double.tryParse(_prixCtrl.text),
            );
      }
      if (mounted) Navigator.pop(context);
    } catch (e) {
      setState(
          () => _erreur = 'Une erreur est survenue. Veuillez réessayer.');
    } finally {
      if (mounted) setState(() => _loading = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    final categoriesAsync = ref.watch(categoriesProvider);
    final bottomInset = MediaQuery.of(context).viewInsets.bottom;

    return Container(
      decoration: const BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
      ),
      padding: EdgeInsets.fromLTRB(20, 0, 20, 20 + bottomInset),
      child: SingleChildScrollView(
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          mainAxisSize: MainAxisSize.min,
          children: [
            // Drag handle
            Center(
              child: Padding(
                padding: const EdgeInsets.only(top: 12, bottom: 16),
                child: Container(
                  width: 36,
                  height: 4,
                  decoration: BoxDecoration(
                    color: _AppColors.border,
                    borderRadius: BorderRadius.circular(2),
                  ),
                ),
              ),
            ),

            // Titre sheet
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                Text(
                  _isModification ? 'Modifier le cours' : 'Nouveau cours',
                  style: GoogleFonts.dmSans(
                      fontSize: 16,
                      fontWeight: FontWeight.w600,
                      color: _AppColors.textPrimary),
                ),
                GestureDetector(
                  onTap: () => Navigator.pop(context),
                  child: Container(
                    padding: const EdgeInsets.all(6),
                    decoration: BoxDecoration(
                      color: _AppColors.bg,
                      borderRadius: BorderRadius.circular(8),
                    ),
                    child: const Icon(Icons.close,
                        size: 16, color: _AppColors.textSecondary),
                  ),
                ),
              ],
            ),

            const SizedBox(height: 20),

            // Erreur
            if (_erreur != null) ...[
              Container(
                padding: const EdgeInsets.all(12),
                decoration: BoxDecoration(
                  color: _AppColors.dangerBg,
                  borderRadius: BorderRadius.circular(12),
                ),
                child: Row(
                  children: [
                    const Icon(Icons.error_outline,
                        size: 16, color: _AppColors.danger),
                    const SizedBox(width: 8),
                    Expanded(
                      child: Text(_erreur!,
                          style: GoogleFonts.dmSans(
                              fontSize: 12,
                              color: _AppColors.danger)),
                    ),
                  ],
                ),
              ),
              const SizedBox(height: 14),
            ],

            // Titre cours
            _FormLabel('Titre du cours'),
            _FormField(
                controller: _titreCtrl,
                hint: 'Ex: Introduction à Flutter'),

            const SizedBox(height: 14),

            // Description
            _FormLabel('Description'),
            _FormField(
              controller: _descCtrl,
              hint: 'Décrivez votre cours en quelques phrases…',
              maxLines: 3,
            ),

            const SizedBox(height: 14),

            // Catégorie
            _FormLabel('Catégorie'),
            categoriesAsync.when(
              loading: () => Container(
                height: 44,
                decoration: BoxDecoration(
                  color: _AppColors.bg,
                  borderRadius: BorderRadius.circular(12),
                  border: Border.all(color: _AppColors.border),
                ),
                child: const Center(
                  child: SizedBox(
                    width: 16,
                    height: 16,
                    child: CircularProgressIndicator(
                        strokeWidth: 2,
                        color: _AppColors.textTertiary),
                  ),
                ),
              ),
              error: (_, __) => Text('Erreur catégories',
                  style: GoogleFonts.dmSans(
                      fontSize: 12, color: _AppColors.danger)),
              data: (cats) {
                if (cats.isEmpty) {
                  // Aucune catégorie — proposer d'en créer une
                  return Container(
                    padding: const EdgeInsets.symmetric(horizontal: 2),
                    child: Row(
                      children: [
                        Expanded(
                          child: Text('Aucune catégorie disponible',
                              style: GoogleFonts.dmSans(
                                  fontSize: 13, color: _AppColors.textTertiary)),
                        ),
                        GestureDetector(
                          onTap: () async {
                            final result = await showModalBottomSheet<Map<String, dynamic>>(
                              context: context,
                              isScrollControlled: true,
                              backgroundColor: Colors.transparent,
                              builder: (_) => const _CreateCategorieSheet(),
                            );
                            if (result != null && mounted) {
                              setState(() {
                                _idCategorie = result['categorie']?['idCategorie'] ?? result['idCategorie'] ?? null;
                              });
                            }
                          },
                          child: Container(
                            padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
                            decoration: BoxDecoration(
                              color: _AppColors.textPrimary,
                              borderRadius: BorderRadius.circular(12),
                            ),
                            child: Text('Ajouter une catégorie',
                                style: GoogleFonts.dmSans(
                                    fontSize: 13,
                                    fontWeight: FontWeight.w600,
                                    color: Colors.white)),
                          ),
                        ),
                      ],
                    ),
                    height: 44,
                  );
                }

                // Sinon afficher dropdown et aussi option de création
                final items = cats
                    .map<DropdownMenuItem<String>>((cat) =>
                        DropdownMenuItem(
                          value: cat['idCategorie'],
                          child: Text(cat['nomCategorie']),
                        ))
                    .toList();
                // Ajouter option pour créer
                items.add(DropdownMenuItem(
                  value: '__create__',
                  child: Text('Ajouter une catégorie...', style: GoogleFonts.dmSans(fontSize: 13)),
                ));

                return Container(
                  height: 44,
                  padding: const EdgeInsets.symmetric(horizontal: 14),
                  decoration: BoxDecoration(
                    color: _AppColors.bg,
                    borderRadius: BorderRadius.circular(12),
                    border: Border.all(color: _AppColors.border),
                  ),
                  child: DropdownButtonHideUnderline(
                    child: DropdownButton<String>(
                      value: _idCategorie,
                      hint: Text('Choisir une catégorie',
                          style: GoogleFonts.dmSans(
                              fontSize: 13,
                              color: _AppColors.textTertiary)),
                      isExpanded: true,
                      style: GoogleFonts.dmSans(
                          fontSize: 13,
                          color: _AppColors.textPrimary),
                      icon: const Icon(Icons.keyboard_arrow_down,
                          size: 18, color: _AppColors.textTertiary),
                      onChanged: (v) async {
                        if (v == '__create__') {
                          final result = await showModalBottomSheet<Map<String, dynamic>>(
                            context: context,
                            isScrollControlled: true,
                            backgroundColor: Colors.transparent,
                            builder: (_) => const _CreateCategorieSheet(),
                          );
                          if (result != null && mounted) {
                            setState(() {
                              _idCategorie = result['categorie']?['idCategorie'] ?? result['idCategorie'] ?? null;
                            });
                          }
                        } else {
                          setState(() => _idCategorie = v);
                        }
                      },
                      items: items,
                    ),
                  ),
                );
              },
            ),

            const SizedBox(height: 14),

            // Niveau
            _FormLabel('Niveau'),
            Container(
              padding: const EdgeInsets.all(4),
              decoration: BoxDecoration(
                color: _AppColors.bg,
                borderRadius: BorderRadius.circular(12),
              ),
              child: Row(
                children: _niveaux.map((n) {
                  final isActive = _niveau == n;
                  final labels = {
                    'DEBUTANT': 'Débutant',
                    'INTERMEDIAIRE': 'Intermédiaire',
                    'AVANCE': 'Avancé',
