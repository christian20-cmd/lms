// Vue grid / list
final viewModeProvider = StateProvider<String>((ref) => 'grid');

class MesCoursScreen extends ConsumerStatefulWidget {
  const MesCoursScreen({super.key});

  @override
  ConsumerState<MesCoursScreen> createState() => _MesCoursScreenState();
}

class _MesCoursScreenState extends ConsumerState<MesCoursScreen>
    with TickerProviderStateMixin {
  late AnimationController _entryController;
  late Animation<double> _entryFade;
  late Animation<Offset> _entrySlide;

  final TextEditingController _searchController = TextEditingController();

  @override
  void initState() {
    super.initState();
    _entryController = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 550),
    );
    _entryFade =
        CurvedAnimation(parent: _entryController, curve: Curves.easeOut);
    _entrySlide = Tween<Offset>(
      begin: const Offset(0, 0.06),
      end: Offset.zero,
    ).animate(
        CurvedAnimation(parent: _entryController, curve: Curves.easeOut));

    Future.delayed(const Duration(milliseconds: 80), () {
      if (mounted) _entryController.forward();
    });

    _searchController.addListener(() {
      ref.read(rechercheCoursProvider.notifier).state =
          _searchController.text;
    });
  }

  @override
  void dispose() {
    _entryController.dispose();
    _searchController.dispose();
    super.dispose();
  }


  // ── Bottom sheet : créer / modifier un cours ──
    void _openCoursSheet({Map<String, dynamic>? cours}) {
      showModalBottomSheet(
        context: context,
        isScrollControlled: true,
        backgroundColor: Colors.transparent,
        builder: (_) => _CoursFormSheet(coursExistant: cours),
      );
    }

  // ── Bottom sheet : confirmer la suppression ──
  void _confirmerSuppression(String idCours, String titre) {
    showModalBottomSheet(
      context: context,
      backgroundColor: Colors.transparent,
      builder: (_) => _ConfirmDeleteSheet(
        titre: titre,
        onConfirm: () async {
          Navigator.pop(context);
          try {
            await ref
                .read(coursNotifierProvider.notifier)
                .supprimerCours(idCours);
            if (mounted) {
              _showSnack('Cours supprimé avec succès', isError: false);
            }
          } catch (_) {
            if (mounted) {
              _showSnack('Erreur lors de la suppression', isError: true);
            }
          }
        },
      ),
    );
  }

  // ── Toggle statut ──
  Future<void> _toggleStatut(String idCours) async {
    try {
      await ref
          .read(coursNotifierProvider.notifier)
          .toggleStatutCours(idCours);
    } catch (_) {
      if (mounted) {
        _showSnack('Erreur lors du changement de statut', isError: true);
      }
    }
  }

  void _showSnack(String msg, {bool isError = false}) {
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text(msg,
            style: GoogleFonts.dmSans(fontSize: 13, color: Colors.white)),
        backgroundColor: isError ? _AppColors.danger : _AppColors.statGreenAccent,
        behavior: SnackBarBehavior.floating,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
        margin: const EdgeInsets.all(16),
      ),
    );
  }

