			acceptedExtensions: ['.mp4', '.mov', '.avi', '.mkv'],
		  ),
		] else if (_typeContenu == 'TEXTE') ...[
		  _FormLabel('Contenu texte'),
		  _FormField(
			controller: _texteCtrl,
			hint: 'Écrivez votre contenu...',
			maxLines: 5,
		  ),
		] else if (_typeContenu == 'DOCUMENT' || _typeContenu == 'IMAGE') ...[
		  _FormLabel('Sélectionner des fichiers'),
		  _MultiFilePickerField(
			onFilesPicked: (paths) =>
				setState(() => _selectedFilePaths = paths),
