		const SizedBox(height: 24),

		// Boutons d'action
		Row(
		  children: [
			Expanded(
			  child: GestureDetector(
				onTap: _loading ? null : () {
				  if (_isCreationWizard) {
					// Revenir au formulaire du module
					setState(() {
					  _resetContenuForm();
					  currentStep = ModuleDrawerStep.editModule;
					});
				  } else {
					setState(() => currentStep = ModuleDrawerStep.selectContenu);
					_resetContenuForm();
				  }
				},
				child: Container(
				  padding: const EdgeInsets.symmetric(vertical: 14),
				  decoration: BoxDecoration(
					color: _AppColors.bg,
					borderRadius: BorderRadius.circular(12),
					border: Border.all(color: _AppColors.border),
				  ),
				  child: Text(_isCreationWizard ? '← Précédent' : 'Retour',
					  textAlign: TextAlign.center,
					  style: GoogleFonts.dmSans(
						  fontSize: 14,
						  fontWeight: FontWeight.w600,
						  color: _AppColors.textPrimary)),
				),
			  ),
			),
			const SizedBox(width: 12),
			Expanded(
			  child: GestureDetector(
				onTap: _loading ? null : _submitContenu,
				child: Container(
				  padding: const EdgeInsets.symmetric(vertical: 14),
				  decoration: BoxDecoration(
					color: _loading
						? _AppColors.textPrimary.withOpacity(0.6)
						: _AppColors.textPrimary,
					borderRadius: BorderRadius.circular(12),
				  ),
				  child: _loading
					  ? const Center(
						  child: SizedBox(
							width: 18,
							height: 18,
							child: CircularProgressIndicator(
								strokeWidth: 2, color: Colors.white),
						  ),
						)
					  : Text(
						  editingContenu == null
							  ? 'Ajouter le contenu'
							  : 'Enregistrer',
						  textAlign: TextAlign.center,
						  style: GoogleFonts.dmSans(
							  fontSize: 14,
							  fontWeight: FontWeight.w600,
							  color: Colors.white)),
				),
			  ),
			),
		  ],
		),
	  ],
	);
  }

  // ACTIONS
  void _selectModule(String idModule, String titre) {
	setState(() {
	  selectedModuleId = idModule;
	  _titreModuleCtrl.text = titre;
	  currentStep = ModuleDrawerStep.selectContenu;
	});
  }

  void _editModule(Map<String, dynamic> module) {
	setState(() {
	  editingModule = module;
	  _titreModuleCtrl.text = module['titreModule'] ?? '';
	  _descModuleCtrl.text = module['descriptionModule'] ?? '';
	  currentStep = ModuleDrawerStep.editModule;
	});
  }

  void _newModule() {
	setState(() {
	  editingModule = null;
	  _titreModuleCtrl.clear();
	  _descModuleCtrl.clear();
	  _erreur = null;
	  _isCreationWizard = true; // Activer le mode wizard
	  _newlyCreatedModuleId = null;
	  currentStep = ModuleDrawerStep.editModule;
	});
  }

  Future<void> _submitModule() async {
	final titre = _titreModuleCtrl.text.trim();
	final desc = _descModuleCtrl.text.trim();

	if (titre.isEmpty || desc.isEmpty) {
	  setState(() => _erreur = 'Tous les champs sont obligatoires');
	  return;
	}

	setState(() {
	  _loading = true;
	  _erreur = null;
	});

	try {
	  if (editingModule == null) {
		await ref
			.read(coursNotifierProvider.notifier)
			.creerModule(
			  idCours: widget.idCours,
			  titreModule: titre,
			  descriptionModule: desc,
			);
		// En mode wizard, passer automatiquement à la création du contenu
		// Récupérer les modules pour trouver le nouvel ID
		if (_isCreationWizard && mounted) {
		  await Future.delayed(const Duration(milliseconds: 300));
		  final modulesData = ref.read(modulesProvider(widget.idCours));
		  if (modulesData is AsyncData) {
			final modules = modulesData.value as List<dynamic>;
			if (modules.isNotEmpty) {
			  // Supposer que le dernier module est celui nouvellement créé
			  final lastModule = modules.last;
			  _newlyCreatedModuleId = lastModule['idModule'];
			  selectedModuleId = _newlyCreatedModuleId;
			}
		  }
		}
	  } else {
		await ref
			.read(coursNotifierProvider.notifier)
			.modifierModule(
			  idCours: widget.idCours,
			  idModule: editingModule!['idModule'],
			  titreModule: titre,
			  descriptionModule: desc,
			);
	  }
	  if (mounted) {
		if (_isCreationWizard && _newlyCreatedModuleId != null) {
		  // Passer automatiquement à la création du contenu
		  setState(() {
			_resetContenuForm();
			currentStep = ModuleDrawerStep.editContenu;
		  });
		} else {
		  setState(() {
			currentStep = ModuleDrawerStep.selectModule;
			_titreModuleCtrl.clear();
			_descModuleCtrl.clear();
			_isCreationWizard = false;
		  });
		}
	  }
	} catch (e) {
	  setState(() => _erreur = 'Erreur: $e');
	} finally {
	  if (mounted) setState(() => _loading = false);
	}
  }

  void _deleteModule(String idModule) {
	showDialog(
	  context: context,
	  builder: (context) => AlertDialog(
		title: const Text('Supprimer ce module ?'),
		content: const Text('Cette action est irréversible'),
		actions: [
		  TextButton(
			onPressed: () => Navigator.pop(context),
			child: const Text('Annuler'),
		  ),
		  TextButton(
			onPressed: () {
			  Navigator.pop(context);
			  _confirmDelete(idModule);
			},
			child: const Text('Supprimer',
				style: TextStyle(color: _AppColors.danger)),
		  ),
		],
	  ),
	);
  }

  Future<void> _confirmDelete(String idModule) async {
	try {
	  await ref
		  .read(coursNotifierProvider.notifier)
		  .supprimerModule(idCours: widget.idCours, idModule: idModule);
	  if (mounted) {
		setState(() => currentStep = ModuleDrawerStep.selectModule);
	  }
	} catch (e) {
	  if (mounted) {
		ScaffoldMessenger.of(context).showSnackBar(
		  SnackBar(content: Text('Erreur: $e')),
		);
	  }
	}
  }

  void _newContenu() {
	setState(() {
	  editingContenu = null;
	  _titreContenuCtrl.clear();
	  _urlCtrl.clear();
	  _texteCtrl.clear();
	  _selectedFilePaths.clear();
	  _typeContenu = 'VIDEO';
	  _erreur = null;
	  currentStep = ModuleDrawerStep.editContenu;
	});
  }

  void _editContenu(Map<String, dynamic> contenu) {
	setState(() {
	  editingContenu = contenu;
	  _titreContenuCtrl.text = contenu['titreContenu'] ?? '';
	  _urlCtrl.text = contenu['lienExterne'] ?? '';
	  _texteCtrl.text = contenu['texteContenu'] ?? '';
	  _typeContenu = contenu['typeContenu'] ?? 'VIDEO';
	  _erreur = null;
	  currentStep = ModuleDrawerStep.editContenu;
	});
  }

  Future<void> _submitContenu() async {
	final titre = _titreContenuCtrl.text.trim();

	if (titre.isEmpty) {
	  setState(() => _erreur = 'Le titre est obligatoire');
	  return;
	}

	if (_typeContenu == 'VIDEO' &&
		_selectedFilePaths.isEmpty &&
		_urlCtrl.text.isEmpty) {
	  setState(
		  () => _erreur = 'Veuillez ajouter un lien ou un fichier vidéo');
	  return;
	}

	if (_typeContenu == 'TEXTE' && _texteCtrl.text.isEmpty) {
	  setState(() => _erreur = 'Le contenu texte est obligatoire');
	  return;
	}

	if ((_typeContenu == 'DOCUMENT' || _typeContenu == 'IMAGE') &&
		_selectedFilePaths.isEmpty) {
	  setState(() => _erreur = 'Veuillez sélectionner au moins un fichier');
	  return;
	}

	setState(() {
	  _loading = true;
	  _erreur = null;
	});

	try {
	  // Upload multi-fichiers
	  for (final filePath in _selectedFilePaths) {
		await ref
			.read(coursNotifierProvider.notifier)
			.ajouterContenu(
			  idCours: widget.idCours,
			  idModule: selectedModuleId!,
			  titreContenu: '$titre - ${_selectedFilePaths.indexOf(filePath) + 1}',
			  typeContenu: _typeContenu,
			  lienExterne:
				  _typeContenu == 'VIDEO' ? _urlCtrl.text.trim() : null,
			  texteContenu:
				  _typeContenu == 'TEXTE' ? _texteCtrl.text.trim() : null,
			  fichierPath: filePath,
			);
	  }

	  if (mounted) {
		if (_isCreationWizard) {
		  // En mode wizard, afficher le menu pour continuer ou terminer
		  _resetContenuForm();
		  setState(() {
			currentStep = ModuleDrawerStep.selectContenu;
			_loading = false;
		  });
		  // Afficher un dialog pour choisir la prochaine action
		  _showWizardNextStepDialog();
		} else {
		  _resetContenuForm();
		  setState(() => currentStep = ModuleDrawerStep.selectContenu);
		}
	  }
	} catch (e) {
	  setState(() => _erreur = 'Erreur: $e');
	} finally {
	  if (mounted) setState(() => _loading = false);
	}
  }

  /// Affiche un dialog pour choisir entre ajouter un autre contenu ou terminer
  void _showWizardNextStepDialog() {
	showDialog(
	  context: context,
	  barrierDismissible: false,
	  builder: (context) => AlertDialog(
		title: Text('Contenu créé avec succès ! 🎉',
			style: GoogleFonts.dmSans(fontWeight: FontWeight.w600)),
		content: Text(
			'Voulez-vous ajouter un autre contenu ou terminer la création du module ?',
			style: GoogleFonts.dmSans(fontSize: 13)),
		actions: [
		  TextButton(
			onPressed: () {
			  Navigator.pop(context);
			  // Continuer avec un autre contenu
			  setState(() => currentStep = ModuleDrawerStep.editContenu);
			},
			child: Text('Ajouter un autre contenu',
				style: GoogleFonts.dmSans(
					fontWeight: FontWeight.w600, color: Colors.blue)),
		  ),
		  TextButton(
			onPressed: () {
			  Navigator.pop(context);
			  _finishWizard();
			},
			child: Text('Terminer et fermer',
				style: GoogleFonts.dmSans(
					fontWeight: FontWeight.w600, color: Colors.green)),
		  ),
		],
	  ),
	);
  }

  /// Terminer le wizard et rediriger vers MesCours
  void _finishWizard() {
	setState(() {
	  _isCreationWizard = false;
	  _newlyCreatedModuleId = null;
	  currentStep = ModuleDrawerStep.selectModule;
	});
	// Fermer le drawer
	Navigator.pop(context);
	// Rediriger vers MesCours (en utilisant go_router ou navigation)
	// Pour l'instant, on reste dans le contexte du widget parent
  }

  void _resetContenuForm() {
	_titreContenuCtrl.clear();
	_urlCtrl.clear();
	_texteCtrl.clear();
	_selectedFilePaths.clear();
	editingContenu = null;
	_typeContenu = 'VIDEO';
  }

  Future<void> _deleteContenu(String idContenu) async {
	try {
	  await ref
		  .read(coursNotifierProvider.notifier)
		  .supprimerContenu(
			idCours: widget.idCours,
			idModule: selectedModuleId!,
			idContenu: idContenu,
		  );
	} catch (e) {
	  if (mounted) {
		ScaffoldMessenger.of(context).showSnackBar(
		  SnackBar(content: Text('Erreur: $e')),
		);
	  }
	}
  }
}

