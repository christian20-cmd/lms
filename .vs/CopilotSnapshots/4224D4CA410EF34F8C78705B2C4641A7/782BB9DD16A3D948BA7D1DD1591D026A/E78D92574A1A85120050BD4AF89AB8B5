import 'dart:io';
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:google_fonts/google_fonts.dart';
import 'package:file_picker/file_picker.dart';
import 'package:LMS/features/enseignant/presentation/providers/cours_provider.dart';

// ── Design tokens ──
class _AppColors {
  static const bg = Color(0xFFF8F8F6);
  static const card = Colors.white;
  static const textPrimary = Color(0xFF1A1A1A);
  static const textSecondary = Color(0xFF8A8A8A);
  static const textTertiary = Color(0xFFB8B8B8);
  static const border = Color(0xFFF0F0EE);
  static const statBlue = Color(0xFFE8F1FB);
  static const statBlueText = Color(0xFF1A5FA8);
  static const statGreen = Color(0xFFE8F5EE);
  static const statGreenText = Color(0xFF1A6B3C);
  static const danger = Color(0xFFE24B4A);
  static const dangerBg = Color(0xFFFCEBEB);
}

// États de navigation du drawer
enum ModuleDrawerStep { selectModule, editModule, selectContenu, editContenu }

class ModuleManagementDrawer extends ConsumerStatefulWidget {
  final String idCours;
  final String titreCours;

  const ModuleManagementDrawer({
	required this.idCours,
	required this.titreCours,
	super.key,
  });

  @override
  ConsumerState<ModuleManagementDrawer> createState() =>
	  _ModuleManagementDrawerState();
}

class _ModuleManagementDrawerState
	extends ConsumerState<ModuleManagementDrawer> {
  ModuleDrawerStep currentStep = ModuleDrawerStep.selectModule;
  String? selectedModuleId;
  String? selectedContenuId;
  String? _newlyCreatedModuleId; // Track du module fraîchement créé
  Map<String, dynamic>? editingModule;
  Map<String, dynamic>? editingContenu;
  bool _isCreationWizard = false; // Wizard mode: créer module + contenu en étapes

  final _titreModuleCtrl = TextEditingController();
  final _descModuleCtrl = TextEditingController();
  final _titreContenuCtrl = TextEditingController();
  final _urlCtrl = TextEditingController();
  final _texteCtrl = TextEditingController();

  String _typeContenu = 'VIDEO';
  String? _selectedFilePath;
  List<String> _selectedFilePaths = [];
  bool _loading = false;
  String? _erreur;

  @override
  void dispose() {
	_titreModuleCtrl.dispose();
	_descModuleCtrl.dispose();
	_titreContenuCtrl.dispose();
	_urlCtrl.dispose();
	_texteCtrl.dispose();
	super.dispose();
  }

  @override
  Widget build(BuildContext context) {
	final bottomInset = MediaQuery.of(context).viewInsets.bottom;
	final modulesAsync = ref.watch(modulesProvider(widget.idCours));

	return Container(
	  decoration: const BoxDecoration(
		color: Colors.white,
		borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
	  ),
	  padding: EdgeInsets.fromLTRB(20, 0, 20, 20 + bottomInset),
	  child: SingleChildScrollView(
		child: Column(
		  crossAxisAlignment: CrossAxisAlignment.start,
		  mainAxisSize: MainAxisSize.min,
		  children: [
			// Drag handle
			Center(
			  child: Padding(
				padding: const EdgeInsets.only(top: 12, bottom: 16),
				child: Container(
				  width: 36,
				  height: 4,
				  decoration: BoxDecoration(
					color: _AppColors.border,
					borderRadius: BorderRadius.circular(2),
				  ),
				),
			  ),
			),

			// Titre et breadcrumb
			Row(
			  mainAxisAlignment: MainAxisAlignment.spaceBetween,
			  children: [
				Expanded(
				  child: Column(
					crossAxisAlignment: CrossAxisAlignment.start,
					children: [
					  Text(
						_getBreadcrumbTitle(),
						style: GoogleFonts.dmSans(
						  fontSize: 16,
						  fontWeight: FontWeight.w600,
						  color: _AppColors.textPrimary,
						),
					  ),
					  if (currentStep != ModuleDrawerStep.selectModule)
						const SizedBox(height: 6),
					  if (currentStep != ModuleDrawerStep.selectModule)
						Text(
						  _getBreadcrumbSubtitle(),
						  style: GoogleFonts.dmSans(
							fontSize: 11,
							color: _AppColors.textSecondary,
						  ),
						),
					],
				  ),
				),
				GestureDetector(
				  onTap: () => Navigator.pop(context),
				  child: Container(
					padding: const EdgeInsets.all(6),
					decoration: BoxDecoration(
					  color: _AppColors.bg,
					  borderRadius: BorderRadius.circular(8),
					),
					child: const Icon(Icons.close,
						size: 16, color: _AppColors.textSecondary),
				  ),
				),
			  ],
			),

			const SizedBox(height: 20),

			// Affichage du contenu selon l'étape
			if (currentStep == ModuleDrawerStep.selectModule)
			  _buildModuleList(modulesAsync)
			else if (currentStep == ModuleDrawerStep.editModule)
			  _buildEditModule()
			else if (currentStep == ModuleDrawerStep.selectContenu)
			  _buildContenuList()
			else if (currentStep == ModuleDrawerStep.editContenu)
			  _buildEditContenu(),
		  ],
		),
	  ),
	);
  }

  String _getBreadcrumbTitle() {
	switch (currentStep) {
	  case ModuleDrawerStep.selectModule:
		return 'Gestion des modules';
	  case ModuleDrawerStep.editModule:
		if (_isCreationWizard) return 'Étape 1: Créer le module';
		return editingModule == null ? 'Nouveau module' : 'Modifier le module';
	  case ModuleDrawerStep.selectContenu:
		if (_isCreationWizard) return 'Étape 2: Ajouter un contenu';
		return 'Contenus du module';
	  case ModuleDrawerStep.editContenu:
		if (_isCreationWizard) return 'Étape 2: Créer le contenu';
		return editingContenu == null ? 'Ajouter un contenu' : 'Modifier le contenu';
	}
  }

  String _getBreadcrumbSubtitle() {
	switch (currentStep) {
	  case ModuleDrawerStep.selectModule:
		return '';
	  case ModuleDrawerStep.editModule:
		if (_isCreationWizard) return '${widget.titreCours} • Wizard de création';
		return widget.titreCours;
	  case ModuleDrawerStep.selectContenu:
		if (_isCreationWizard) return 'Pour: ${_titreModuleCtrl.text}';
		return 'Dans: ${_titreModuleCtrl.text}';
	  case ModuleDrawerStep.editContenu:
		if (_isCreationWizard) return 'Type: $_typeContenu';
		return 'Contenu: $_typeContenu';
	}
  }

  Widget _buildModuleList(AsyncValue<List<dynamic>> modulesAsync) {
	return modulesAsync.when(
	  loading: () => const Center(
		child: CircularProgressIndicator(strokeWidth: 2),
	  ),
	  error: (err, _) => Center(
		child: Text('Erreur: $err',
			style: GoogleFonts.dmSans(
				fontSize: 12, color: _AppColors.danger)),
	  ),
	  data: (modules) {
		return Column(
		  mainAxisSize: MainAxisSize.min,
		  children: [
			// Erreur
			if (_erreur != null) ...[
			  Container(
				padding: const EdgeInsets.all(12),
				decoration: BoxDecoration(
				  color: _AppColors.dangerBg,
				  borderRadius: BorderRadius.circular(12),
				),
				child: Row(
				  children: [
					const Icon(Icons.error_outline,
						size: 16, color: _AppColors.danger),
					const SizedBox(width: 8),
					Expanded(
					  child: Text(_erreur!,
						  style: GoogleFonts.dmSans(
							  fontSize: 12,
							  color: _AppColors.danger)),
					),
				  ],
				),
			  ),
			  const SizedBox(height: 14),
			],

			// Liste des modules
			if (modules.isEmpty)
			  Padding(
				padding: const EdgeInsets.symmetric(vertical: 24),
				child: Column(
				  children: [
					Container(
					  width: 60,
					  height: 60,
					  decoration: BoxDecoration(
						color: _AppColors.statBlue,
						borderRadius: BorderRadius.circular(16),
					  ),
					  child: const Icon(Icons.layers_outlined,
						  size: 28,
						  color: _AppColors.statBlueText),
					),
					const SizedBox(height: 12),
					Text('Aucun module créé',
						style: GoogleFonts.dmSans(
							fontSize: 13,
							fontWeight: FontWeight.w500,
							color: _AppColors.textPrimary)),
					const SizedBox(height: 4),
					Text('Créez votre premier module',
						style: GoogleFonts.dmSans(
							fontSize: 11,
							color: _AppColors.textSecondary)),
				  ],
				),
			  )
			else
			  ListView.separated(
				shrinkWrap: true,
				physics: const NeverScrollableScrollPhysics(),
				itemCount: modules.length,
				separatorBuilder: (_, __) => const SizedBox(height: 10),
				itemBuilder: (context, index) {
				  final module = modules[index];
				  final titre = module['titreModule'] ?? 'Module sans titre';
				  final desc = module['descriptionModule'] ?? '';
				  final statut = module['statutModule'] ?? 'BROUILLON';
				  final idModule = module['idModule'] ?? '';
				  final contenusCount = module['_count']?['contenus'] ?? 0;

				  return GestureDetector(
					onTap: () => _selectModule(idModule, titre),
					onLongPress: () => _editModule(module),
					child: Container(
					  padding: const EdgeInsets.all(12),
					  decoration: BoxDecoration(
						color: _AppColors.bg,
						borderRadius: BorderRadius.circular(12),
						border: Border.all(color: _AppColors.border),
					  ),
					  child: Row(
						children: [
						  Container(
							width: 40,
							height: 40,
							decoration: BoxDecoration(
							  color: _AppColors.statBlue,
							  borderRadius: BorderRadius.circular(10),
							),
							child: const Icon(Icons.layers_outlined,
								size: 18, color: _AppColors.statBlueText),
						  ),
						  const SizedBox(width: 12),
						  Expanded(
							child: Column(
							  crossAxisAlignment: CrossAxisAlignment.start,
							  children: [
								Text(titre,
									style: GoogleFonts.dmSans(
										fontSize: 12,
										fontWeight: FontWeight.w500,
										color: _AppColors.textPrimary),
									maxLines: 1,
									overflow: TextOverflow.ellipsis),
								const SizedBox(height: 4),
								Row(
								  children: [
									Text('$contenusCount contenus',
										style: GoogleFonts.dmSans(
											fontSize: 10,
											color: _AppColors.textTertiary)),
									const SizedBox(width: 8),
									Container(
									  padding: const EdgeInsets.symmetric(
										  horizontal: 6, vertical: 2),
									  decoration: BoxDecoration(
										color: statut == 'PUBLIE'
											? _AppColors.statGreen
											: _AppColors.statBlue,
										borderRadius: BorderRadius.circular(4),
									  ),
									  child: Text(
										statut == 'PUBLIE'
											? 'Pub.'
											: 'Brouillon',
										style: GoogleFonts.dmSans(
										  fontSize: 8,
										  fontWeight: FontWeight.w600,
										  color: statut == 'PUBLIE'
											  ? _AppColors.statGreenText
											  : _AppColors.statBlueText,
										),
									  ),
									),
								  ],
								),
							  ],
							),
						  ),
						  PopupMenuButton(
							itemBuilder: (context) => [
							  PopupMenuItem(
								onTap: () => _editModule(module),
								child: const Row(
								  children: [
									Icon(Icons.edit_outlined, size: 16),
									SizedBox(width: 8),
									Text('Modifier'),
								  ],
								),
							  ),
							  PopupMenuItem(
								onTap: () => _deleteModule(idModule),
								child: const Row(
								  children: [
									Icon(Icons.delete_outline, size: 16,
										color: _AppColors.danger),
									SizedBox(width: 8),
									Text('Supprimer',
										style: TextStyle(
											color: _AppColors.danger)),
								  ],
								),
							  ),
							],
							child: const Icon(Icons.more_vert,
								size: 16, color: _AppColors.textTertiary),
						  ),
						],
					  ),
					),
				  );
				},
			  ),

			const SizedBox(height: 20),

			// Bouton créer module
			GestureDetector(
			  onTap: _newModule,
			  child: Container(
				width: double.infinity,
				padding: const EdgeInsets.symmetric(vertical: 14),
				decoration: BoxDecoration(
				  color: _AppColors.textPrimary,
				  borderRadius: BorderRadius.circular(12),
				),
				child: Row(
				  mainAxisAlignment: MainAxisAlignment.center,
				  children: [
					const Icon(Icons.add, size: 18, color: Colors.white),
					const SizedBox(width: 6),
					Text('Créer un module',
						style: GoogleFonts.dmSans(
							fontSize: 14,
							fontWeight: FontWeight.w600,
							color: Colors.white)),
				  ],
				),
			  ),
			),
		  ],
		);
	  },
	);
  }

  Widget _buildEditModule() {
	return Column(
	  mainAxisSize: MainAxisSize.min,
	  crossAxisAlignment: CrossAxisAlignment.start,
	  children: [
		// Erreur
		if (_erreur != null) ...[
		  Container(
			padding: const EdgeInsets.all(12),
			decoration: BoxDecoration(
			  color: _AppColors.dangerBg,
			  borderRadius: BorderRadius.circular(12),
			),
			child: Row(
			  children: [
				const Icon(Icons.error_outline,
					size: 16, color: _AppColors.danger),
				const SizedBox(width: 8),
				Expanded(
				  child: Text(_erreur!,
					  style: GoogleFonts.dmSans(
						  fontSize: 12,
						  color: _AppColors.danger)),
				),
			  ],
			),
		  ),
		  const SizedBox(height: 14),
		],

		_FormLabel('Titre du module'),
		_FormField(
		  controller: _titreModuleCtrl,
		  hint: 'Ex: Fondamentaux',
		),
		const SizedBox(height: 14),
		_FormLabel('Description'),
		_FormField(
		  controller: _descModuleCtrl,
		  hint: 'Décrivez le contenu du module...',
		  maxLines: 3,
		),
		const SizedBox(height: 24),

		// Boutons d'action
		Row(
		  children: [
			Expanded(
			  child: GestureDetector(
				onTap: _loading ? null : () {
				  if (_isCreationWizard) {
					// Annuler le wizard
					setState(() {
					  _isCreationWizard = false;
					  _newlyCreatedModuleId = null;
					  currentStep = ModuleDrawerStep.selectModule;
					  _titreModuleCtrl.clear();
					  _descModuleCtrl.clear();
					  _erreur = null;
					});
				  } else {
					setState(() => currentStep = ModuleDrawerStep.selectModule);
				  }
				},
				child: Container(
				  padding: const EdgeInsets.symmetric(vertical: 14),
				  decoration: BoxDecoration(
					color: _AppColors.bg,
					borderRadius: BorderRadius.circular(12),
					border: Border.all(color: _AppColors.border),
				  ),
				  child: Text(_isCreationWizard ? 'Annuler' : 'Retour',
					  textAlign: TextAlign.center,
					  style: GoogleFonts.dmSans(
						  fontSize: 14,
						  fontWeight: FontWeight.w600,
						  color: _AppColors.textPrimary)),
				),
			  ),
			),
			const SizedBox(width: 12),
			Expanded(
			  child: GestureDetector(
				onTap: _loading ? null : _submitModule,
				child: Container(
				  padding: const EdgeInsets.symmetric(vertical: 14),
				  decoration: BoxDecoration(
					color: _loading
						? _AppColors.textPrimary.withValues(alpha: 0.6)
						: _AppColors.textPrimary,
					borderRadius: BorderRadius.circular(12),
				  ),
				  child: _loading
					  ? const Center(
						  child: SizedBox(
							width: 18,
							height: 18,
							child: CircularProgressIndicator(
								strokeWidth: 2, color: Colors.white),
						  ),
						)
					  : Text(
						  _isCreationWizard ? 'Suivant →' : (editingModule == null ? 'Créer le module' : 'Enregistrer'),
						  textAlign: TextAlign.center,
						  style: GoogleFonts.dmSans(
							  fontSize: 14,
							  fontWeight: FontWeight.w600,
							  color: Colors.white)),
				),
			  ),
			),
		  ],
		),
	  ],
	);
  }

  Widget _buildContenuList() {
	final contenusAsync = ref.watch(
	  contenusProvider((
		idCours: widget.idCours,
		idModule: selectedModuleId!,
	  )),
	);

	return contenusAsync.when(
	  loading: () => const Center(
		child: CircularProgressIndicator(strokeWidth: 2),
	  ),
	  error: (err, _) => Center(
		child: Text('Erreur: $err',
			style: GoogleFonts.dmSans(
				fontSize: 12, color: _AppColors.danger)),
	  ),
	  data: (contenus) {
		return Column(
		  mainAxisSize: MainAxisSize.min,
		  children: [
			// Liste des contenus
			if (contenus.isEmpty)
			  Padding(
				padding: const EdgeInsets.symmetric(vertical: 24),
				child: Column(
				  children: [
					Container(
					  width: 60,
					  height: 60,
					  decoration: BoxDecoration(
						color: _AppColors.statGreen,
						borderRadius: BorderRadius.circular(16),
					  ),
					  child: const Icon(Icons.description_outlined,
						  size: 28,
						  color: _AppColors.statGreenText),
					),
					const SizedBox(height: 12),
					Text('Aucun contenu',
						style: GoogleFonts.dmSans(
							fontSize: 13,
							fontWeight: FontWeight.w500,
							color: _AppColors.textPrimary)),
					const SizedBox(height: 4),
					Text('Ajoutez du contenu à ce module',
						style: GoogleFonts.dmSans(
							fontSize: 11,
							color: _AppColors.textSecondary)),
				  ],
				),
			  )
			else
			  ListView.separated(
				shrinkWrap: true,
				physics: const NeverScrollableScrollPhysics(),
				itemCount: contenus.length,
				separatorBuilder: (_, __) => const SizedBox(height: 10),
				itemBuilder: (context, index) {
				  final contenu = contenus[index];
				  final titre = contenu['titreContenu'] ?? 'Contenu sans titre';
				  final type = contenu['typeContenu'] ?? 'TEXTE';

				  final iconMap = {
					'VIDEO': Icons.play_circle_outline,
					'DOCUMENT': Icons.description_outlined,
					'TEXTE': Icons.text_fields,
					'IMAGE': Icons.image_outlined,
				  };

				  return GestureDetector(
					onLongPress: () => _editContenu(contenu),
					child: Container(
					  padding: const EdgeInsets.all(12),
					  decoration: BoxDecoration(
						color: _AppColors.bg,
						borderRadius: BorderRadius.circular(12),
						border: Border.all(color: _AppColors.border),
					  ),
					  child: Row(
						children: [
						  Container(
							width: 40,
							height: 40,
							decoration: BoxDecoration(
							  color: _AppColors.statGreen,
							  borderRadius: BorderRadius.circular(10),
							),
							child: Icon(
								iconMap[type] ?? Icons.file_present,
								size: 18,
								color: _AppColors.statGreenText),
						  ),
						  const SizedBox(width: 12),
						  Expanded(
							child: Column(
							  crossAxisAlignment: CrossAxisAlignment.start,
							  children: [
								Text(titre,
									style: GoogleFonts.dmSans(
										fontSize: 12,
										fontWeight: FontWeight.w500,
										color: _AppColors.textPrimary),
									maxLines: 1,
									overflow: TextOverflow.ellipsis),
								const SizedBox(height: 4),
								Text(type,
									style: GoogleFonts.dmSans(
										fontSize: 10,
										color: _AppColors.textTertiary)),
							  ],
							),
						  ),
						  PopupMenuButton(
							itemBuilder: (context) => [
							  PopupMenuItem(
								onTap: () => _editContenu(contenu),
								child: const Row(
								  children: [
									Icon(Icons.edit_outlined, size: 16),
									SizedBox(width: 8),
									Text('Modifier'),
								  ],
								),
							  ),
							  PopupMenuItem(
								onTap: () =>
									_deleteContenu(contenu['idContenu']),
								child: const Row(
								  children: [
									Icon(Icons.delete_outline, size: 16,
										color: _AppColors.danger),
									SizedBox(width: 8),
									Text('Supprimer',
										style: TextStyle(
											color: _AppColors.danger)),
								  ],
								),
							  ),
							],
							child: const Icon(Icons.more_vert,
								size: 16, color: _AppColors.textTertiary),
						  ),
						],
					  ),
					),
				  );
				},
			  ),

			const SizedBox(height: 20),

			// Bouton ajouter contenu
			GestureDetector(
			  onTap: _newContenu,
			  child: Container(
				width: double.infinity,
				padding: const EdgeInsets.symmetric(vertical: 14),
				decoration: BoxDecoration(
				  color: _AppColors.textPrimary,
				  borderRadius: BorderRadius.circular(12),
				),
				child: Row(
				  mainAxisAlignment: MainAxisAlignment.center,
				  children: [
					const Icon(Icons.add, size: 18, color: Colors.white),
					const SizedBox(width: 6),
					Text('Ajouter un contenu',
						style: GoogleFonts.dmSans(
							fontSize: 14,
							fontWeight: FontWeight.w600,
							color: Colors.white)),
				  ],
				),
			  ),
			),

			const SizedBox(height: 12),

			// Bouton retour
			GestureDetector(
			  onTap: () {
				setState(() => currentStep = ModuleDrawerStep.selectModule);
			  },
			  child: Container(
				width: double.infinity,
				padding: const EdgeInsets.symmetric(vertical: 14),
				decoration: BoxDecoration(
				  color: _AppColors.bg,
				  borderRadius: BorderRadius.circular(12),
				  border: Border.all(color: _AppColors.border),
				),
				child: Text('Retour aux modules',
					textAlign: TextAlign.center,
					style: GoogleFonts.dmSans(
						fontSize: 14,
						fontWeight: FontWeight.w600,
						color: _AppColors.textPrimary)),
			  ),
			),
		  ],
		);
	  },
	);
  }

  Widget _buildEditContenu() {
	return Column(
	  mainAxisSize: MainAxisSize.min,
	  crossAxisAlignment: CrossAxisAlignment.start,
	  children: [
		// Erreur
		if (_erreur != null) ...[
		  Container(
			padding: const EdgeInsets.all(12),
			decoration: BoxDecoration(
			  color: _AppColors.dangerBg,
			  borderRadius: BorderRadius.circular(12),
			),
			child: Row(
			  children: [
				const Icon(Icons.error_outline,
					size: 16, color: _AppColors.danger),
				const SizedBox(width: 8),
				Expanded(
				  child: Text(_erreur!,
					  style: GoogleFonts.dmSans(
						  fontSize: 12,
						  color: _AppColors.danger)),
				),
			  ],
			),
		  ),
		  const SizedBox(height: 14),
		],

		_FormLabel('Type de contenu'),
		Container(
		  padding: const EdgeInsets.all(4),
		  decoration: BoxDecoration(
			color: _AppColors.bg,
			borderRadius: BorderRadius.circular(12),
		  ),
		  child: Row(
