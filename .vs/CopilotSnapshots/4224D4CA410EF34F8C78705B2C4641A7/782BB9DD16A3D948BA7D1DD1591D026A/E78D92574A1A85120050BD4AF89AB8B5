class _MultiFilePickerField extends StatefulWidget {
  final Function(List<String>) onFilesPicked;
  final List<String> selectedFiles;
  final List<String> acceptedExtensions;

  const _MultiFilePickerField({
	required this.onFilesPicked,
	required this.selectedFiles,
	required this.acceptedExtensions,
  });

  @override
  State<_MultiFilePickerField> createState() => _MultiFilePickerFieldState();
}

class _MultiFilePickerFieldState extends State<_MultiFilePickerField> {
  @override
  Widget build(BuildContext context) {
	return GestureDetector(
	  onTap: _pickFiles,
	  child: Container(
		padding: const EdgeInsets.all(12),
		decoration: BoxDecoration(
		  color: _AppColors.bg,
		  borderRadius: BorderRadius.circular(12),
		  border: Border.all(color: _AppColors.border, width: 1.5),
		),
		child: Column(
		  crossAxisAlignment: CrossAxisAlignment.start,
		  children: [
			Row(
			  children: [
				const Icon(Icons.cloud_upload_outlined,
					size: 18, color: _AppColors.textSecondary),
				const SizedBox(width: 10),
				Expanded(
				  child: Column(
					crossAxisAlignment: CrossAxisAlignment.start,
					children: [
					  Text('Cliquez ou glissez des fichiers',
						  style: GoogleFonts.dmSans(
							  fontSize: 12,
							  fontWeight: FontWeight.w500,
							  color: _AppColors.textPrimary)),
					  const SizedBox(height: 4),
					  Text(
						  'Formats acceptés: ${widget.acceptedExtensions.join(", ")}',
						  style: GoogleFonts.dmSans(
							  fontSize: 10,
							  color: _AppColors.textTertiary)),
					],
				  ),
				),
			  ],
			),
			if (widget.selectedFiles.isNotEmpty) ...[
			  const SizedBox(height: 12),
			  Container(
				padding: const EdgeInsets.all(8),
				decoration: BoxDecoration(
				  color: _AppColors.statGreen,
				  borderRadius: BorderRadius.circular(8),
				),
				child: Column(
				  crossAxisAlignment: CrossAxisAlignment.start,
				  children: [
					Row(
					  mainAxisAlignment: MainAxisAlignment.spaceBetween,
					  children: [
						Text('${widget.selectedFiles.length} fichier(s) sélectionné(s)',
							style: GoogleFonts.dmSans(
								fontSize: 10,
								fontWeight: FontWeight.w500,
								color: _AppColors.statGreenText)),
						GestureDetector(
						  onTap: () => widget.onFilesPicked([]),
						  child: Text('Effacer',
							  style: GoogleFonts.dmSans(
								  fontSize: 9,
								  fontWeight: FontWeight.w600,
								  color: _AppColors.statGreenText)),
						),
					  ],
					),
					const SizedBox(height: 4),
					...widget.selectedFiles.asMap().entries.map((entry) {
					  final int index = entry.key;
					  final String file = entry.value;
					  final fileName = file.split('/').last;
					  final fileSizeInMb = _getFileSizeInMb(file);
					  return Padding(
						padding: const EdgeInsets.only(top: 4),
						child: Row(
						  children: [
							Expanded(
							  child: Column(
								crossAxisAlignment: CrossAxisAlignment.start,
								children: [
								  Text('• $fileName',
									  style: GoogleFonts.dmSans(
										  fontSize: 9,
										  fontWeight: FontWeight.w500,
										  color: _AppColors.statGreenText),
									  maxLines: 1,
									  overflow: TextOverflow.ellipsis),
								  Text('$fileSizeInMb MB',
									  style: GoogleFonts.dmSans(
										  fontSize: 8,
										  color: _AppColors.statGreenText
											  .withValues(alpha: 0.7))),
								],
							  ),
							),
							GestureDetector(
							  onTap: () {
								final updated = [...widget.selectedFiles];
								updated.removeAt(index);
								widget.onFilesPicked(updated);
							  },
							  child: const Icon(Icons.close,
								  size: 14,
								  color: _AppColors.statGreenText),
							),
						  ],
						),
					  );
					}).toList(),
				  ],
				),
			  ),
			],
		  ],
		),
	  ),
	);
  }

  Future<void> _pickFiles() async {
	try {
	  // Créer les patterns acceptés pour file_picker
	  final allowedExtensions =
		  widget.acceptedExtensions.map((e) => e.replaceFirst('.', '')).toList();

	  // Utiliser file_picker pour sélectionner les fichiers
	  final result = await FilePicker.platform.pickFiles(
		type: FileType.custom,
		allowedExtensions: allowedExtensions,
		allowMultiple: true,
		onFileLoading: (FilePickerStatus status) {
		  // Optionnel: afficher une progress bar
		},
	  );

	  if (result != null) {
		final paths = result.paths
			.whereType<String>()
			.toList();
		widget.onFilesPicked([...widget.selectedFiles, ...paths]);
	  }
	} catch (e) {
	  if (mounted) {
		ScaffoldMessenger.of(context).showSnackBar(
		  SnackBar(
			content: Text('Erreur lors de la sélection: $e'),
			backgroundColor: _AppColors.danger,
		  ),
		);
	  }
	}
  }

  String _getFileSizeInMb(String filePath) {
	try {
	  final file = File(filePath);
	  final sizeInBytes = file.lengthSync();
	  final sizeInMb = sizeInBytes / (1024 * 1024);
	  return sizeInMb.toStringAsFixed(2);
	} catch (_) {
	  return '0';
	}
  }
}
