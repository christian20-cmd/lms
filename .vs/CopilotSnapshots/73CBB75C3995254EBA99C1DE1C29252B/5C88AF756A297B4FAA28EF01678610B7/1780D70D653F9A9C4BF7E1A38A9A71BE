class _VideoPlayerSheetState extends State<_VideoPlayerSheet> {
  VideoPlayerController? _ctrl;
  bool _initialized = false, _playing = false;

  @override
  void initState() { super.initState(); _initPlayer(); }

  Future<void> _initPlayer() async {
    VideoPlayerController ctrl;
    if (widget.lienExterne != null && widget.lienExterne!.isNotEmpty) {
      ctrl = VideoPlayerController.networkUrl(Uri.parse(widget.lienExterne!));
    } else if (widget.fichierUrl != null) {
      const baseUrl = 'http://localhost:3000';
      ctrl = VideoPlayerController.networkUrl(Uri.parse('$baseUrl${widget.fichierUrl}'));
    } else { return; }
    await ctrl.initialize();
    if (mounted) {
      setState(() { _ctrl = ctrl; _initialized = true; });
      ctrl.play();
      setState(() => _playing = true);
    }
  }

  @override
  void dispose() { _ctrl?.dispose(); super.dispose(); }

  @override
  Widget build(BuildContext context) => SafeArea(
    child: Column(mainAxisSize: MainAxisSize.min, children: [
      Padding(padding: const EdgeInsets.all(12), child: Row(
        mainAxisAlignment: MainAxisAlignment.end,
        children: [GestureDetector(
          onTap: () => Navigator.pop(context),
          child: const Icon(Icons.close, color: Colors.white70, size: 22),
        )],
      )),
      if (!_initialized)
        const SizedBox(height: 200,
            child: Center(child: CircularProgressIndicator(color: Colors.white)))
      else AspectRatio(aspectRatio: _ctrl!.value.aspectRatio, child: VideoPlayer(_ctrl!)),
      if (_initialized) ...[
        const SizedBox(height: 12),
        VideoProgressIndicator(_ctrl!, allowScrubbing: true,
          colors: const VideoProgressColors(
            playedColor: _C.blue, bufferedColor: Colors.white24,
            backgroundColor: Colors.white12),
          padding: const EdgeInsets.symmetric(horizontal: 16)),
        const SizedBox(height: 8),
        Row(mainAxisAlignment: MainAxisAlignment.center, children: [
          IconButton(
            icon: Icon(_playing ? Icons.pause_rounded : Icons.play_arrow_rounded,
                color: Colors.white, size: 32),
            onPressed: () => setState(() {
              _playing ? _ctrl!.pause() : _ctrl!.play();
              _playing = !_playing;
            }),
          ),
        ]),
      ],
      const SizedBox(height: 16),
    ]),
  );
}

