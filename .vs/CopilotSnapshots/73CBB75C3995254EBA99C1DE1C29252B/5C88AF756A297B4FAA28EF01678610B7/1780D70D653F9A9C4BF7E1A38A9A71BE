enum _Step { module, contenu }

// ── Types contenu meta ─────────────────────────────────────────
const _typesMeta = {
  'VIDEO':    (icon: Icons.play_circle_outline_rounded, color: _C.blue,   soft: _C.blueSoft,   label: 'Vidéo'),
  'DOCUMENT': (icon: Icons.description_outlined,        color: _C.amber,  soft: _C.amberSoft,  label: 'Document'),
  'IMAGE':    (icon: Icons.image_outlined,              color: _C.purple, soft: _C.purpleSoft, label: 'Image'),
  'TEXTE':    (icon: Icons.article_outlined,            color: _C.green,  soft: _C.greenSoft,  label: 'Texte'),
