  String _fileSize(String path) {
    try {
      final bytes = File(path).lengthSync();
      if (bytes < 1024)    return '${bytes}B';
      if (bytes < 1048576) return '${(bytes / 1024).toStringAsFixed(1)}KB';
      return '${(bytes / 1048576).toStringAsFixed(1)}MB';
    } catch (_) { return ''; }
  }
}

