// ── Représentation d'un fichier ajouté ─────────────────────────
class _UploadItem {
  final String path;
  final String type; // VIDEO / DOCUMENT / IMAGE
  _UploadItem({required this.path, required this.type});
}

// ══════════════════════════════════════════════════════════════
class ModuleManagementDrawer extends ConsumerStatefulWidget {
  final String idCours;
  final String titreCours;

  const ModuleManagementDrawer({
    required this.idCours,
    required this.titreCours,
    super.key,
  });

  @override
  ConsumerState<ModuleManagementDrawer> createState() =>
      _ModuleManagementDrawerState();
}

class _ModuleManagementDrawerState
    extends ConsumerState<ModuleManagementDrawer>
    with TickerProviderStateMixin {

  // ── Navigation ──
  _Step _step = _Step.module;
  String? _selectedModuleId;
  String? _selectedModuleTitle;
  Map<String, dynamic>? _editingModule;
  Map<String, dynamic>? _editingContenu;
  bool _isWizard = false;

  // ── Controllers ──
  final _titreModCtrl = TextEditingController();
  final _descModCtrl  = TextEditingController();
  final _titreCntCtrl = TextEditingController(); // UN seul titre pour tous les fichiers
  final _urlCtrl      = TextEditingController();
  final _texteCtrl    = TextEditingController();

  // ── Etat upload unifié ──
  List<_UploadItem> _uploadItems = [];
  bool _showTexteField = false;
  double _uploadProgress = 0;
  bool _loading = false;
  String? _erreur;

  // ── Animation stepper ──
  late final AnimationController _stepAnim;
  late final AnimationController _progressAnim;
  late Animation<double> _progressVal;

  // ── Lecteur vidéo preview ──
  VideoPlayerController? _videoCtrl;
  bool _videoInitialized = false;

  @override
  void initState() {
    super.initState();
    _stepAnim = AnimationController(vsync: this, duration: const Duration(milliseconds: 400));
    _progressAnim = AnimationController(vsync: this, duration: const Duration(milliseconds: 600));
    _progressVal = Tween<double>(begin: 0, end: 0).animate(
      CurvedAnimation(parent: _progressAnim, curve: Curves.easeInOut),
    );
  }

  @override
  void dispose() {
    _stepAnim.dispose();
    _progressAnim.dispose();
    _titreModCtrl.dispose();
    _descModCtrl.dispose();
    _titreCntCtrl.dispose();
    _urlCtrl.dispose();
    _texteCtrl.dispose();
    _videoCtrl?.dispose();
    super.dispose();
  }

  void _animateProgress(double to) {
    _progressVal = Tween<double>(begin: _progressVal.value, end: to)
        .animate(CurvedAnimation(parent: _progressAnim, curve: Curves.easeInOut));
    _progressAnim.forward(from: 0);
  }

  // ── Ajouter fichiers pour un type ──
  Future<void> _pickFilesForType(String type, List<String> exts, bool multi) async {
    if (type == 'TEXTE') {
      setState(() => _showTexteField = true);
      return;
    }
    try {
      final result = await FilePicker.platform.pickFiles(
        type: FileType.custom,
        allowedExtensions: exts,
        allowMultiple: multi,
      );
      if (result != null) {
        final paths = result.paths.whereType<String>().toList();
        setState(() {
          for (final p in paths) {
            _uploadItems.add(_UploadItem(path: p, type: type));
          }
          _erreur = null;
        });
        if (type == 'VIDEO' && paths.isNotEmpty) {
          _initVideoPreview(paths.first);
        }
      }
    } catch (e) {
      setState(() => _erreur = 'Erreur sélection: $e');
    }
  }

  Future<void> _initVideoPreview(String path) async {
    _videoCtrl?.dispose();
    setState(() => _videoInitialized = false);
    final ctrl = VideoPlayerController.file(File(path));
    await ctrl.initialize();
    if (mounted) setState(() { _videoCtrl = ctrl; _videoInitialized = true; });
  }

  void _removeItem(int index) {
    final item = _uploadItems[index];
    if (item.type == 'VIDEO') {
      _videoCtrl?.dispose();
      _videoCtrl = null;
      _videoInitialized = false;
    }
    setState(() => _uploadItems.removeAt(index));
  }

  void _resetContenu() {
    _titreCntCtrl.clear();
    _urlCtrl.clear();
    _texteCtrl.clear();
    _videoCtrl?.dispose();
    _videoCtrl = null;
    _videoInitialized = false;
    setState(() {
      _uploadItems = [];
      _showTexteField = false;
      _uploadProgress = 0;
      _editingContenu = null;
      _erreur = null;
    });
  }

  // ── Créer / modifier module ──
  Future<void> _submitModule() async {
    final titre = _titreModCtrl.text.trim();
    final desc  = _descModCtrl.text.trim();
    if (titre.isEmpty || desc.isEmpty) {
      setState(() => _erreur = 'Titre et description sont obligatoires');
      return;
    }
    setState(() { _loading = true; _erreur = null; });
    try {
      if (_editingModule == null) {
        await ref.read(coursNotifierProvider.notifier).creerModule(
          idCours: widget.idCours,
          titreModule: titre,
          descriptionModule: desc,
        );
        await Future.delayed(const Duration(milliseconds: 200));
        final modules = await ref.read(modulesProvider(widget.idCours).future);
        if (modules.isNotEmpty) {
          final last = modules.last;
          _selectedModuleId    = last['idModule'];
          _selectedModuleTitle = last['titreModule'];
        }
        if (_isWizard && mounted) {
          _animateProgress(1.0);
          setState(() => _step = _Step.contenu);
        } else {
          if (mounted) setState(() => _step = _Step.module);
        }
      } else {
        await ref.read(coursNotifierProvider.notifier).modifierModule(
          idCours: widget.idCours,
          idModule: _editingModule!['idModule'],
          titreModule: titre,
          descriptionModule: desc,
        );
        if (mounted) setState(() => _step = _Step.module);
      }
    } catch (e) {
      setState(() => _erreur = e.toString().replaceAll('Exception: ', ''));
    } finally {
      if (mounted) setState(() => _loading = false);
    }
  }

  // ── Soumettre contenu — UN titre, multi-fichiers multi-types ──
  Future<void> _submitContenu() async {
    final titre = _titreCntCtrl.text.trim();
    if (titre.isEmpty) {
      setState(() => _erreur = 'Le titre est obligatoire');
      return;
    }

    final hasTexte = _showTexteField && _texteCtrl.text.trim().isNotEmpty;
    final hasFiles = _uploadItems.isNotEmpty;
    final hasUrl   = _urlCtrl.text.trim().isNotEmpty;

    if (!hasTexte && !hasFiles && !hasUrl) {
      setState(() => _erreur = 'Ajoutez au moins un fichier, un lien vidéo ou du texte');
      return;
    }

    setState(() { _loading = true; _erreur = null; _uploadProgress = 0; });

    try {
      final tasks = <({String type, String? path, String? lien, String? texte})>[];

      for (final item in _uploadItems) {
        tasks.add((type: item.type, path: item.path, lien: null, texte: null));
      }
      if (hasUrl) {
        tasks.add((type: 'VIDEO', path: null, lien: _urlCtrl.text.trim(), texte: null));
      }
      if (hasTexte) {
        tasks.add((type: 'TEXTE', path: null, lien: null, texte: _texteCtrl.text.trim()));
      }

      for (int i = 0; i < tasks.length; i++) {
        final task = tasks[i];
        // Titre unique — on garde le même pour tous
        await ref.read(coursNotifierProvider.notifier).ajouterContenu(
          idCours:      widget.idCours,
          idModule:     _selectedModuleId!,
          titreContenu: titre,
          typeContenu:  task.type,
          lienExterne:  task.lien,
          texteContenu: task.texte,
          fichierPath:  task.path,
          onSendProgress: (sent, total) {
            if (mounted) setState(() {
              _uploadProgress = (i + (sent / total)) / tasks.length;
            });
          },
        );
      }

      if (mounted) {
        _resetContenu();
        if (_isWizard) {
          _showWizardDoneSheet();
        } else {
          setState(() => _step = _Step.contenu);
        }
      }
    } catch (e) {
      setState(() => _erreur = e.toString().replaceAll('Exception: ', ''));
    } finally {
      if (mounted) setState(() { _loading = false; _uploadProgress = 0; });
    }
  }

  void _showWizardDoneSheet() {
    showModalBottomSheet(
      context: context,
      backgroundColor: Colors.transparent,
      builder: (_) => _WizardDoneSheet(
        onAddMore: () { Navigator.pop(context); setState(() {}); },
        onFinish: () { Navigator.pop(context); Navigator.pop(context); },
      ),
    );
  }

  Future<void> _deleteModule(String idModule) async {
    final confirm = await showDialog<bool>(
      context: context,
      builder: (_) => AlertDialog(
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
        title: Text('Supprimer ce module ?',
            style: GoogleFonts.dmSans(fontWeight: FontWeight.w600)),
        content: Text('Cette action est irréversible.',
            style: GoogleFonts.dmSans(fontSize: 13, color: _C.muted)),
        actions: [
          TextButton(onPressed: () => Navigator.pop(context, false),
              child: Text('Annuler', style: GoogleFonts.dmSans())),
          TextButton(
            onPressed: () => Navigator.pop(context, true),
            child: Text('Supprimer',
                style: GoogleFonts.dmSans(color: _C.red, fontWeight: FontWeight.w600)),
          ),
        ],
      ),
    );
    if (confirm == true) {
      await ref.read(coursNotifierProvider.notifier)
          .supprimerModule(idCours: widget.idCours, idModule: idModule);
    }
  }

  Future<void> _deleteContenu(String idContenu) async {
    await ref.read(coursNotifierProvider.notifier).supprimerContenu(
      idCours:   widget.idCours,
      idModule:  _selectedModuleId!,
      idContenu: idContenu,
    );
  }

  // ═══════════════════════════════════════════════════════════════
  //  BUILD
  // ═══════════════════════════════════════════════════════════════
  @override
  Widget build(BuildContext context) {
    final inset = MediaQuery.of(context).viewInsets.bottom;
    return Container(
      decoration: const BoxDecoration(
        color: _C.surface,
        borderRadius: BorderRadius.vertical(top: Radius.circular(28)),
      ),
      padding: EdgeInsets.fromLTRB(0, 0, 0, 20 + inset),
      child: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          const SizedBox(height: 12),
          Center(child: Container(
            width: 36, height: 4,
            decoration: BoxDecoration(color: _C.faint, borderRadius: BorderRadius.circular(2)),
          )),
          const SizedBox(height: 16),
          Padding(
            padding: const EdgeInsets.symmetric(horizontal: 24),
            child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
              Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [
                Text(_headerTitle(), style: GoogleFonts.dmSans(
                    fontSize: 18, fontWeight: FontWeight.w700, color: _C.ink)),
                GestureDetector(
                  onTap: () => Navigator.pop(context),
                  child: Container(
                    padding: const EdgeInsets.all(6),
                    decoration: BoxDecoration(
                        color: _C.bg, borderRadius: BorderRadius.circular(8)),
                    child: const Icon(Icons.close, size: 18, color: _C.muted),
                  ),
                ),
              ]),
              if (_isWizard) ...[const SizedBox(height: 16), _buildStepper()],
            ]),
          ),
          const SizedBox(height: 20),
          const Divider(height: 1, color: Color(0xFFF0F0EE)),
          const SizedBox(height: 4),
          Flexible(
            child: SingleChildScrollView(
              padding: const EdgeInsets.fromLTRB(24, 16, 24, 0),
              child: AnimatedSwitcher(
                duration: const Duration(milliseconds: 300),
                transitionBuilder: (child, anim) => FadeTransition(
                  opacity: anim,
                  child: SlideTransition(
                    position: Tween<Offset>(
                        begin: const Offset(0.04, 0), end: Offset.zero).animate(anim),
                    child: child,
                  ),
                ),
                child: _buildBody(),
              ),
            ),
          ),
        ],
      ),
    );
  }

  String _headerTitle() {
    if (_isWizard) return _step == _Step.module ? 'Créer un module' : 'Ajouter du contenu';
    switch (_step) {
      case _Step.module:  return 'Mes modules';
      case _Step.contenu: return _selectedModuleTitle ?? 'Contenus';
    }
  }

  Widget _buildStepper() {
    return Column(children: [
      Row(children: [
        _StepBadge(num: 1, active: true, done: _step == _Step.contenu),
        Expanded(child: AnimatedBuilder(
          animation: _progressVal,
          builder: (_, __) => LinearProgressIndicator(
            value: _progressVal.value,
            backgroundColor: _C.faint,
            valueColor: const AlwaysStoppedAnimation(_C.blue),
            minHeight: 2,
            borderRadius: BorderRadius.circular(2),
          ),
        )),
        _StepBadge(num: 2, active: _step == _Step.contenu, done: false),
      ]),
      const SizedBox(height: 6),
      Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [
        Text('Module', style: GoogleFonts.dmSans(
            fontSize: 11, fontWeight: FontWeight.w500, color: _C.blue)),
        Text('Contenu', style: GoogleFonts.dmSans(
            fontSize: 11, fontWeight: FontWeight.w500,
            color: _step == _Step.contenu ? _C.blue : _C.muted)),
      ]),
    ]);
  }

  Widget _buildBody() {
    switch (_step) {
      case _Step.module:  return _buildModuleList();
      case _Step.contenu: return _isWizard ? _buildContenuForm() : _buildContenuList();
    }
  }

  // ══════════════════════════════════════════════
  //  LISTE DES MODULES
  // ══════════════════════════════════════════════
  Widget _buildModuleList() {
    final modulesAsync = ref.watch(modulesProvider(widget.idCours));
    return modulesAsync.when(
      loading: () => const _LoadingPlaceholder(),
      error: (e, _) => _ErrorBox(message: e.toString()),
      data: (modules) => Column(
        key: const ValueKey('module-list'),
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          if (_erreur != null) ...[_ErrorBox(message: _erreur!), const SizedBox(height: 14)],
          if (modules.isEmpty)
            _EmptyState(
              icon: Icons.layers_outlined,
              title: 'Aucun module',
              subtitle: 'Créez votre premier module ci-dessous',
              color: _C.blue, colorSoft: _C.blueSoft,
            )
          else
            ...modules.map((m) => _ModuleTile(
              module: m,
              onTap: () => setState(() {
                _selectedModuleId    = m['idModule'];
                _selectedModuleTitle = m['titreModule'];
                _titreModCtrl.text   = m['titreModule'] ?? '';
                _isWizard = false;
                _step = _Step.contenu;
              }),
              onEdit: () {
                setState(() {
                  _editingModule     = m;
                  _titreModCtrl.text = m['titreModule'] ?? '';
                  _descModCtrl.text  = m['descriptionModule'] ?? '';
                  _erreur = null;
                  _isWizard = false;
                });
                _showModuleFormSheet();
              },
              onDelete: () => _deleteModule(m['idModule']),
              onToggle: () => ref.read(coursNotifierProvider.notifier)
                  .toggleStatutModule(idCours: widget.idCours, idModule: m['idModule']),
            )),
          const SizedBox(height: 20),
          _PrimaryButton(
            label: 'Créer un module',
            icon: Icons.add_rounded,
            onTap: () {
              _editingModule = null;
              _titreModCtrl.clear();
              _descModCtrl.clear();
              _isWizard = true;
              _animateProgress(0);
              setState(() { _step = _Step.module; _erreur = null; });
              _showModuleFormSheet();
            },
          ),
          const SizedBox(height: 24),
        ],
      ),
    );
  }

  void _showModuleFormSheet() {
    showModalBottomSheet(
      context: context,
      isScrollControlled: true,
      backgroundColor: Colors.transparent,
      builder: (_) => _ModuleFormSheet(
        titreCtrl: _titreModCtrl,
        descCtrl:  _descModCtrl,
        isEditing: _editingModule != null,
        isWizard:  _isWizard,
        loading:   _loading,
        erreur:    _erreur,
        onSubmit: () async { Navigator.pop(context); await _submitModule(); },
        onCancel: () => Navigator.pop(context),
      ),
    );
  }

  // ══════════════════════════════════════════════
  //  LISTE DES CONTENUS
  // ══════════════════════════════════════════════
  Widget _buildContenuList() {
    final contenusAsync = ref.watch(contenusProvider((
      idCours:  widget.idCours,
      idModule: _selectedModuleId!,
    )));
    return contenusAsync.when(
      loading: () => const _LoadingPlaceholder(),
      error: (e, _) => _ErrorBox(message: e.toString()),
      data: (contenus) => Column(
        key: const ValueKey('contenu-list'),
        children: [
          if (contenus.isEmpty)
            _EmptyState(
              icon: Icons.inbox_outlined,
              title: 'Aucun contenu',
              subtitle: 'Ajoutez du contenu à ce module',
              color: _C.green, colorSoft: _C.greenSoft,
            )
          else
            ...contenus.map((c) => _ContenuTile(
              contenu: c,
              onEdit: () {
                setState(() {
                  _editingContenu    = c;
                  _titreCntCtrl.text = c['titreContenu'] ?? '';
                  _urlCtrl.text      = c['lienExterne']  ?? '';
                  _texteCtrl.text    = c['texteContenu'] ?? '';
                  _uploadItems       = [];
                  _showTexteField    = (c['typeContenu'] == 'TEXTE');
                  _erreur            = null;
                  _isWizard          = false;
                });
                _showContenuFormSheet();
              },
              onDelete: () => _deleteContenu(c['idContenu']),
            )),
          const SizedBox(height: 20),
          _PrimaryButton(
            label: 'Ajouter un contenu',
            icon: Icons.add_rounded,
            onTap: () { _resetContenu(); _showContenuFormSheet(); },
          ),
          const SizedBox(height: 12),
          _SecondaryButton(
            label: 'Retour aux modules',
            onTap: () => setState(() { _step = _Step.module; _selectedModuleId = null; }),
          ),
          const SizedBox(height: 24),
        ],
      ),
    );
  }

  // ══════════════════════════════════════════════
  //  FORMULAIRE CONTENU (inline wizard)
  // ══════════════════════════════════════════════
  Widget _buildContenuForm() {
    return Column(
      key: const ValueKey('contenu-form'),
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Container(
          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
          decoration: BoxDecoration(color: _C.blueSoft, borderRadius: BorderRadius.circular(10)),
          child: Row(children: [
            const Icon(Icons.layers_outlined, size: 14, color: _C.blue),
            const SizedBox(width: 8),
            Expanded(child: Text(_selectedModuleTitle ?? '',
                style: GoogleFonts.dmSans(
                    fontSize: 12, fontWeight: FontWeight.w500, color: _C.blue))),
          ]),
        ),
        const SizedBox(height: 20),
        _contenuFormFields(),
        const SizedBox(height: 24),
        if (_loading && _uploadProgress > 0) ...[
          _UploadProgressBar(progress: _uploadProgress),
          const SizedBox(height: 16),
        ],
        Row(children: [
          _SecondaryButton(
            label: '← Précédent',
            onTap: _loading ? null : () {
              _animateProgress(0);
              setState(() => _step = _Step.module);
            },
          ),
          const SizedBox(width: 12),
          Expanded(child: _PrimaryButton(
            label: _loading ? 'Upload en cours…' : 'Ajouter',
            icon: _loading ? null : Icons.check_rounded,
            loading: _loading,
            onTap: _loading ? null : _submitContenu,
          )),
        ]),
        const SizedBox(height: 24),
      ],
    );
  }

  void _showContenuFormSheet() {
    showModalBottomSheet(
      context: context,
      isScrollControlled: true,
      backgroundColor: Colors.transparent,
      builder: (_) => _ContenuFormSheet(
        drawerState: this,
        onSubmit: () async { Navigator.pop(context); await _submitContenu(); },
        onCancel: () => Navigator.pop(context),
      ),
    );
  }

  // ══════════════════════════════════════════════
  //  CHAMPS FORMULAIRE CONTENU
  //  — titre unique + upload unifié B&W —
  // ══════════════════════════════════════════════
  Widget _contenuFormFields() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        // ── Titre unique pour tous les fichiers ──
        _Label('Titre du contenu'),
        const SizedBox(height: 8),
        _TextField(controller: _titreCntCtrl, hint: 'Ex: Introduction Flutter'),
        const SizedBox(height: 20),

        // ── Zone upload dynamique (pas de filtrage type) ──
        _Label('Ajouter des fichiers'),
        const SizedBox(height: 12),
        _UnifiedUploadZone(
          uploadItems:   _uploadItems,
          showTexte:     _showTexteField,
          texteCtrl:     _texteCtrl,
          urlCtrl:       _urlCtrl,
          videoCtrl:     _videoCtrl,
          videoInit:     _videoInitialized,
          onPickType:    _pickFilesForType,
          onRemoveItem:  _removeItem,
          onRemoveTexte: () => setState(() {
            _showTexteField = false;
            _texteCtrl.clear();
          }),
          onSetState: setState,
        ),

        // ── Erreur ──
        if (_erreur != null) ...[
          const SizedBox(height: 14),
          _ErrorBox(message: _erreur!),
        ],
      ],
    );
  }
}

// ═══════════════════════════════════════════════════════════════
//  ZONE UPLOAD UNIFIÉE — NOIR & BLANC
// ═══════════════════════════════════════════════════════════════
class _UnifiedUploadZone extends StatefulWidget {
  final List<_UploadItem> uploadItems;
  final bool showTexte;
  final TextEditingController texteCtrl;
  final TextEditingController urlCtrl;
  final VideoPlayerController? videoCtrl;
  final bool videoInit;
  final Future<void> Function(String type, List<String> exts, bool multi) onPickType;
  final void Function(int index) onRemoveItem;
  final VoidCallback onRemoveTexte;
