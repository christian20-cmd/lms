class CoursCardExample extends StatelessWidget {
  final String idCours;
  final String titre;
  final String description;

  const CoursCardExample({
	required this.idCours,
	required this.titre,
	required this.description,
  });

  @override
  Widget build(BuildContext context) {
	return GestureDetector(
	  // ✅ NOUVEAU: Navigation vers CoursDetailScreen
	  // Tous les modules et contenus sont affichés en une seule page
	  onTap: () => _navigateToCoursDetail(),
	  child: Container(
		padding: const EdgeInsets.all(16),
		child: Column(
		  crossAxisAlignment: CrossAxisAlignment.start,
		  children: [
			Text(titre),
			Text(description),
			ElevatedButton(
			  onPressed: () => _navigateToCoursDetail(),
			  child: const Text('Voir le cours'),
			),
		  ],
		),
	  ),
	);
  }

  void _navigateToCoursDetail() {
	Navigator.push(
	  // context va venir du BuildContext
	  context as BuildContext,
	  MaterialPageRoute(
		// ✅ Utiliser CoursDetailScreen
		// Pas besoin de passer par ModuleDetailScreen
		builder: (context) => CoursDetailScreen(
		  idCours: idCours,
		  titreCours: titre,
		  descriptionCours: description,
		),
	  ),
	);
  }
}

