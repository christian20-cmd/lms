// ── États du workflow ──
enum WorkflowStep { createModule, addContent, contentList }

class UnifiedModuleContentDrawer extends ConsumerStatefulWidget {
  final String idCours;
  final String titreCours;

  const UnifiedModuleContentDrawer({
	required this.idCours,
	required this.titreCours,
	super.key,
  });

  @override
  ConsumerState<UnifiedModuleContentDrawer> createState() =>
	  _UnifiedModuleContentDrawerState();
}

class _UnifiedModuleContentDrawerState
	extends ConsumerState<UnifiedModuleContentDrawer> {
  // ── Workflow ──
  WorkflowStep currentStep = WorkflowStep.createModule;
  String? createdModuleId; // ID du module fraîchement créé
  String? createdModuleTitle; // Titre pour affichage

  // ── Formulaires ──
  final _titreModuleCtrl = TextEditingController();
  final _descModuleCtrl = TextEditingController();
  final _titreContenuCtrl = TextEditingController();
  final _urlCtrl = TextEditingController();
  final _texteCtrl = TextEditingController();

  // ── État contenu ──
  String _typeContenu = 'VIDEO'; // VIDEO | IMAGE | DOCUMENT | TEXTE | URL
  String? _selectedFilePath;
  bool _loading = false;
  String? _erreur;

  // ── Types de contenu disponibles ──
  final List<String> _typesContenu = ['VIDEO', 'IMAGE', 'DOCUMENT', 'TEXTE', 'URL'];

  @override
  void dispose() {
	_titreModuleCtrl.dispose();
	_descModuleCtrl.dispose();
	_titreContenuCtrl.dispose();
	_urlCtrl.dispose();
	_texteCtrl.dispose();
	super.dispose();
  }

  // ── Étape 1: Créer module ──
  Future<void> _creerModule() async {
	final titre = _titreModuleCtrl.text.trim();
	final desc = _descModuleCtrl.text.trim();

	if (titre.isEmpty) {
	  setState(() => _erreur = 'Le titre du module est obligatoire');
	  return;
	}
	if (desc.isEmpty) {
	  setState(() => _erreur = 'La description du module est obligatoire');
	  return;
	}

	setState(() {
	  _loading = true;
	  _erreur = null;
	});

	try {
	  print('📝 [_creerModule] Création du module: $titre');
	  await ref.read(coursNotifierProvider.notifier).creerModule(
		idCours: widget.idCours,
		titreModule: titre,
		descriptionModule: desc,
	  );

	  print('✅ [_creerModule] Module créé avec succès');

	  // Récupérer la liste des modules et prendre le dernier (celui qu'on vient de créer)
	  final modulesAsync = await ref.read(modulesProvider(widget.idCours).future);
	  if (modulesAsync.isNotEmpty) {
		final lastModule = modulesAsync.last;
		setState(() {
		  createdModuleId = lastModule['idModule'];
		  createdModuleTitle = lastModule['titreModule'];
		  currentStep = WorkflowStep.addContent;
		  _erreur = null;
		});
	  }
	} catch (e) {
	  print('❌ [_crierModule] Erreur: $e');
	  setState(() => _erreur = 'Erreur: ${e.toString().replaceAll("Exception: ", "")}');
	} finally {
	  if (mounted) setState(() => _loading = false);
	}
  }

  // ── Choisir fichier ──
  Future<void> _pickFile() async {
	try {
	  print('📁 [_pickFile] Ouverture du sélecteur de fichier');
	  final result = await FilePicker.platform.pickFiles();
	  if (result != null && result.files.isNotEmpty) {
		setState(() => _selectedFilePath = result.files.first.path);
		print('✅ [_pickFile] Fichier sélectionné: $_selectedFilePath');
	  }
	} catch (e) {
	  print('❌ [_pickFile] Erreur: $e');
	  setState(() => _erreur = 'Erreur sélection fichier: $e');
	}
  }

  // ── Étape 2: Ajouter contenu ──
  Future<void> _ajouterContenu() async {
	final titre = _titreContenuCtrl.text.trim();

	if (titre.isEmpty) {
	  setState(() => _erreur = 'Le titre du contenu est obligatoire');
	  return;
	}

	// Validation selon le type
	if (_typeContenu == 'VIDEO' || _typeContenu == 'IMAGE' || _typeContenu == 'DOCUMENT') {
	  if (_selectedFilePath == null && _selectedFilePath!.isEmpty) {
		setState(() => _erreur = 'Veuillez sélectionner un fichier');
		return;
	  }
	} else if (_typeContenu == 'URL') {
	  if (_urlCtrl.text.trim().isEmpty) {
		setState(() => _erreur = 'L\'URL est obligatoire');
		return;
	  }
	} else if (_typeContenu == 'TEXTE') {
	  if (_texteCtrl.text.trim().isEmpty) {
		setState(() => _erreur = 'Le texte est obligatoire');
		return;
	  }
	}

	setState(() {
	  _loading = true;
	  _erreur = null;
	});

	try {
	  print('📝 [_ajouterContenu] Ajout de contenu: $titre (type: $_typeContenu)');

	  await ref.read(coursNotifierProvider.notifier).ajouterContenu(
		idCours: widget.idCours,
		idModule: createdModuleId!,
		titreContenu: titre,
		typeContenu: _typeContenu,
		lienExterne: _typeContenu == 'URL' ? _urlCtrl.text.trim() : null,
		texteContenu: _typeContenu == 'TEXTE' ? _texteCtrl.text.trim() : null,
		fichierPath: (_typeContenu == 'VIDEO' || _typeContenu == 'IMAGE' || _typeContenu == 'DOCUMENT')
			? _selectedFilePath
			: null,
	  );

	  print('✅ [_ajouterContenu] Contenu ajouté avec succès');

	  // Réinitialiser le formulaire contenu
	  setState(() {
		_titreContenuCtrl.clear();
		_urlCtrl.clear();
		_texteCtrl.clear();
		_selectedFilePath = null;
		_typeContenu = 'VIDEO';
		_erreur = null;
	  });
	} catch (e) {
	  print('❌ [_ajouterContenu] Erreur: $e');
	  setState(() => _erreur = 'Erreur: ${e.toString().replaceAll("Exception: ", "")}');
	} finally {
	  if (mounted) setState(() => _loading = false);
	}
  }

  // ── Terminer et fermer ──
  void _finish() {
	print('✅ [_finish] Fermeture du drawer');
	Navigator.pop(context);
  }

