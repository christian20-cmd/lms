import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:flutter_secure_storage/flutter_secure_storage.dart';
import '../../data/auth_remote_datasource.dart';
import '../../data/auth_repository.dart';
import '../../domain/user_model.dart';
import '../../../../core/network/dio_client.dart';

// ── Providers de base ──

final dioProvider = Provider((ref) => DioClient.createDio());

final authDatasourceProvider = Provider((ref) {
  return AuthRemoteDatasource(ref.read(dioProvider));
});

final authRepositoryProvider = Provider((ref) {
  return AuthRepository(ref.read(authDatasourceProvider));
});

// ── Auth State ──

class AuthState {
  final UserModel? user;
  final String? token;
  final bool isLoading;
  final String? error;

  AuthState({
    this.user,
    this.token,
    this.isLoading = false,
    this.error,
  });

  AuthState copyWith({
    UserModel? user,
    String? token,
    bool? isLoading,
    String? error,
  }) {
    return AuthState(
      user: user ?? this.user,
      token: token ?? this.token,
      isLoading: isLoading ?? this.isLoading,
      error: error,
    );
  }

  bool get isAuthenticated => token != null && user != null;
}

// ── Auth Notifier ──

class AuthNotifier extends StateNotifier<AuthState> {
  final AuthRepository _repository;
  final FlutterSecureStorage _storage;

  AuthNotifier(this._repository, this._storage) : super(AuthState()) {
    _chargerSession();
  }

  Future<void> completerProfil({
    required String roleUser,
    String? idVille,
    String? idOperateur,
    String? numeroTelUser,
    String? bioUser,
    String? niveauApprenant,
    String? idEtablissement,
    String? specialiteEnseignant,
    String? titreProfessionnelEnseignant,
  }) async {
    state = state.copyWith(isLoading: true, error: null);
    try {
      final data = await _repository.completerProfil(
        roleUser: roleUser,
        idVille: idVille,
        idOperateur: idOperateur,
        numeroTelUser: numeroTelUser,
        bioUser: bioUser,
        niveauApprenant: niveauApprenant,
        idEtablissement: idEtablissement,
        specialiteEnseignant: specialiteEnseignant,
        titreProfessionnelEnseignant: titreProfessionnelEnseignant,
      );
      final token = data['token'] as String;
      final user = data['user'] as UserModel;

      await _storage.write(key: 'token', value: token);
      await _storage.write(key: 'idUser', value: user.idUser);
      await _storage.write(key: 'nomUser', value: user.nomUser);
      await _storage.write(key: 'prenomUser', value: user.prenomUser);
      await _storage.write(key: 'emailUser', value: user.emailUser);
      await _storage.write(key: 'roleUser', value: user.roleUser);

      state = state.copyWith(isLoading: false, token: token, user: user);
    } catch (e) {
      state = state.copyWith(isLoading: false, error: e.toString());
      rethrow;
    }
  }

  // Connecter depuis OAuth
  Future<void> connecterOAuth({
    required String token,
    required String idUser,
    required String nomUser,
    required String prenomUser,
    required String emailUser,
    required String roleUser,
    String? photoProfilUser,
  }) async {
    await _storage.write(key: 'token', value: token);
    await _storage.write(key: 'idUser', value: idUser);
    await _storage.write(key: 'nomUser', value: nomUser);
    await _storage.write(key: 'prenomUser', value: prenomUser);
    await _storage.write(key: 'emailUser', value: emailUser);
    await _storage.write(key: 'roleUser', value: roleUser);

    state = state.copyWith(
      token: token,
      user: UserModel(
        idUser: idUser,
        nomUser: nomUser,
        prenomUser: prenomUser,
        emailUser: emailUser,
        roleUser: roleUser,
      ),
    );
  }
  // Charger session au démarrage
  Future<void> _chargerSession() async {
    final token = await _storage.read(key: 'token');
    final idUser = await _storage.read(key: 'idUser');
    final nomUser = await _storage.read(key: 'nomUser');
    final prenomUser = await _storage.read(key: 'prenomUser');
    final emailUser = await _storage.read(key: 'emailUser');
    final roleUser = await _storage.read(key: 'roleUser');

    if (token != null && idUser != null) {
      // Vérifier si le token est toujours valide
      try {
        await _repository.validerToken(token);

        state = state.copyWith(
          token: token,
          user: UserModel(
            idUser: idUser,
            nomUser: nomUser!,
            prenomUser: prenomUser!,
            emailUser: emailUser!,
            roleUser: roleUser!,
          ),
        );
      } catch (e) {
        // Token expiré ou invalide → supprimer la session
        await _storage.deleteAll();
        state = AuthState();
      }
    }
  }

  // ── LOGIN ──

  Future<void> verifierEmailLogin(String emailUser) async {
    // Supprimer isLoading ici — c'est juste une vérification silencieuse
    try {
      await _repository.verifierEmailLogin(emailUser);
    } catch (e) {
      rethrow;
    }
  }

  Future<void> login({
    required String emailUser,
    required String passwordUser,
  }) async {
    state = state.copyWith(isLoading: true, error: null);
    try {
      final data = await _repository.login(
        emailUser: emailUser,
        passwordUser: passwordUser,
      );
      final token = data['token'] as String;
      final user = data['user'] as UserModel;

      await _storage.write(key: 'token', value: token);
      await _storage.write(key: 'idUser', value: user.idUser);
      await _storage.write(key: 'nomUser', value: user.nomUser);
      await _storage.write(key: 'prenomUser', value: user.prenomUser);
      await _storage.write(key: 'emailUser', value: user.emailUser);
      await _storage.write(key: 'roleUser', value: user.roleUser);

      state = state.copyWith(isLoading: false, token: token, user: user);
    } catch (e) {
      state = state.copyWith(isLoading: false, error: e.toString());
      rethrow;
    }
  }
  // ── RESET PASSWORD ──

  Future<void> demanderResetPassword(String emailUser) async {
    try {
      await _repository.demanderResetPassword(emailUser);
    } catch (e) {
      rethrow;
    }
  }

  Future<void> verifierCodeReset({
    required String emailUser,
    required String code,
  }) async {
    try {
      await _repository.verifierCodeReset(emailUser: emailUser, code: code);
    } catch (e) {
      rethrow;
    }
  }

  Future<void> reinitialiserPassword({
    required String emailUser,
    required String code,
    required String newPassword,
  }) async {
    try {
      await _repository.reinitialiserPassword(
        emailUser: emailUser,
        code: code,
        newPassword: newPassword,
      );
    } catch (e) {
      rethrow;
    }
  }

  // ── LOGOUT ──

  Future<void> logout() async {
    await _storage.deleteAll();
    state = AuthState();
  }

  // ── REGISTER steps ──

  Future<void> validerNomPrenom({
    required String nomUser,
    required String prenomUser,
  }) async {
    try {
      await _repository.validerNomPrenom(
        nomUser: nomUser,
        prenomUser: prenomUser,
      );
    } catch (e) {
      rethrow;
    }
  }

  Future<void> verifierEmailInscription(String emailUser) async {
    try {
      await _repository.verifierEmailInscription(emailUser);
    } catch (e) {
      rethrow;
    }
  }

  Future<void> envoyerCode(String emailUser) async {
    try {
      await _repository.envoyerCode(emailUser);
    } catch (e) {
      rethrow;
    }
  }

  Future<void> verifierCode({
    required String emailUser,
    required String code,
  }) async {
    try {
      await _repository.verifierCode(
        emailUser: emailUser,
        code: code,
      );
    } catch (e) {
      rethrow;
    }
  }

  Future<void> validerPassword(String passwordUser) async {
    try {
      await _repository.validerPassword(passwordUser);
    } catch (e) {
      rethrow;
    }
  }

  // ── REGISTER final ──

  Future<void> register({
    required String nomUser,
    required String prenomUser,
    required String emailUser,
    required String passwordUser,
    required String roleUser,
    String? numeroTelUser,
    String? idVille,
    String? idOperateur,
    String? bioUser,
    String? specialiteEnseignant,
    String? titreProfessionnelEnseignant,
    String? niveauApprenant,
    String? idEtablissement,
    List<Map<String, String>>? reseauxSociaux,
  }) async {
    state = state.copyWith(isLoading: true, error: null);
    try {
      final data = await _repository.register(
        nomUser: nomUser,
        prenomUser: prenomUser,
        emailUser: emailUser,
        passwordUser: passwordUser,
        roleUser: roleUser,
        numeroTelUser: numeroTelUser,
        idVille: idVille,
        idOperateur: idOperateur,
        bioUser: bioUser,
        specialiteEnseignant: specialiteEnseignant,
        titreProfessionnelEnseignant: titreProfessionnelEnseignant,
        niveauApprenant: niveauApprenant,
        idEtablissement: idEtablissement,
        reseauxSociaux: reseauxSociaux,
      );
      final token = data['token'] as String;
      final user = data['user'] as UserModel;

      await _storage.write(key: 'token', value: token);
      await _storage.write(key: 'idUser', value: user.idUser);
      await _storage.write(key: 'nomUser', value: user.nomUser);
      await _storage.write(key: 'prenomUser', value: user.prenomUser);
      await _storage.write(key: 'emailUser', value: user.emailUser);
      await _storage.write(key: 'roleUser', value: user.roleUser);

      state = state.copyWith(isLoading: false, token: token, user: user);
    } catch (e) {
      state = state.copyWith(isLoading: false, error: e.toString());
      rethrow;
    }
  }
}

// ── Provider final ──

final authProvider = StateNotifierProvider<AuthNotifier, AuthState>((ref) {
  return AuthNotifier(
    ref.read(authRepositoryProvider),
    const FlutterSecureStorage(),
  );
});