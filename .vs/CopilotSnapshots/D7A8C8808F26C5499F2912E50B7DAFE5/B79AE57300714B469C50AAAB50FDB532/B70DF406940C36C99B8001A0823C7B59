import 'package:dio/dio.dart';
import '../data/auth_remote_datasource.dart';
import '../domain/user_model.dart';

class AuthRepository {
  final AuthRemoteDatasource _datasource;

  AuthRepository(this._datasource);

  // ── Extraire le message proprement depuis une DioException ──
  String _extractMessage(DioException e, String fallback) {
    try {
      final data = e.response?.data;
      if (data is Map) {
        final msg = data['message'];
        if (msg != null && msg.toString().isNotEmpty) {
          return msg.toString();
        }
      }
    } catch (_) {}
    return fallback;
  }

  // ── LOGIN ──

  Future<Map<String, dynamic>> verifierEmailLogin(String emailUser) async {
    try {
      print('🔍 [verifierEmailLogin] Vérification de l\'email: $emailUser');
      final data = await _datasource.verifierEmailLogin(emailUser);

      print('📊 [verifierEmailLogin] Réponse reçue: $data');
      print('📊 [verifierEmailLogin] Champ existe: ${data['existe']}');

      // Vérifier si le champ 'existe' existe et est false
      if (data['existe'] == false) {
        print('❌ [verifierEmailLogin] Email non trouvé');
        throw Exception(data['message'] ?? 'Aucun compte associé à cet email');
      }

      print('✅ [verifierEmailLogin] Email trouvé avec succès');
      return data;
    } on DioException catch (e) {
      print('💥 [verifierEmailLogin] DioException: ${e.message}');
      print('💥 [verifierEmailLogin] Statut HTTP: ${e.response?.statusCode}');
      print('💥 [verifierEmailLogin] Réponse: ${e.response?.data}');
      throw Exception(_extractMessage(e, 'Erreur de connexion'));
    } catch (e) {
      print('💥 [verifierEmailLogin] Exception: $e');
      rethrow;
    }
  }

  Future<Map<String, dynamic>> login({
    required String emailUser,
    required String passwordUser,
  }) async {
    try {
      print('🔐 [login] Tentative de connexion: $emailUser');
      final data = await _datasource.login(
        emailUser: emailUser,
        passwordUser: passwordUser,
      );

      print('✅ [login] Réponse du serveur reçue');
      print('✅ [login] Token reçu: ${data['token'] != null ? 'OUI' : 'NON'}');
      print('✅ [login] User data: ${data['user']}');

      return {
        'token': data['token'],
        'user': UserModel.fromJson(data['user']),
      };
    } on DioException catch (e) {
      print('💥 [login] DioException: ${e.message}');
      print('💥 [login] Statut HTTP: ${e.response?.statusCode}');
      print('💥 [login] Réponse: ${e.response?.data}');
      throw Exception(_extractMessage(e, 'Identifiants incorrects'));
    } catch (e) {
      print('💥 [login] Exception: $e');
      rethrow;
    }
  }

  Future<Map<String, dynamic>> completerProfil({
    required String roleUser,
    String? idVille,
    String? idOperateur,
    String? numeroTelUser,
    String? bioUser,
    String? niveauApprenant,
    String? idEtablissement,
    String? specialiteEnseignant,
    String? titreProfessionnelEnseignant,
  }) async {
    try {
      final data = await _datasource.completerProfil(
        roleUser: roleUser,
        idVille: idVille,
        idOperateur: idOperateur,
        numeroTelUser: numeroTelUser,
        bioUser: bioUser,
        niveauApprenant: niveauApprenant,
        idEtablissement: idEtablissement,
        specialiteEnseignant: specialiteEnseignant,
        titreProfessionnelEnseignant: titreProfessionnelEnseignant,
      );
      return {
        'token': data['token'],
        'user': UserModel.fromJson(data['user']),
      };
    } on DioException catch (e) {
      throw Exception(_extractMessage(e, 'Erreur lors de la complétion du profil'));
    }
  }
  // ── REGISTER ──

  Future<void> validerNomPrenom({
    required String nomUser,
    required String prenomUser,
  }) async {
    try {
      await _datasource.validerNomPrenom(
        nomUser: nomUser,
        prenomUser: prenomUser,
      );
    } on DioException catch (e) {
      throw Exception(_extractMessage(e, 'Nom ou prénom invalide'));
    }
  }

  Future<void> verifierEmailInscription(String emailUser) async {
    try {
      await _datasource.verifierEmailInscription(emailUser);
    } on DioException catch (e) {
      throw Exception(_extractMessage(e, 'Erreur de vérification email'));
    }
  }

  Future<void> envoyerCode(String emailUser) async {
    try {
      await _datasource.envoyerCode(emailUser);
    } on DioException catch (e) {
      throw Exception(_extractMessage(e, 'Erreur envoi du code'));
    }
  }

  Future<void> verifierCode({
    required String emailUser,
    required String code,
  }) async {
    try {
      await _datasource.verifierCode(
        emailUser: emailUser,
        code: code,
      );
    } on DioException catch (e) {
      throw Exception(_extractMessage(e, 'Code incorrect'));
    }
  }

  Future<void> validerPassword(String passwordUser) async {
    try {
      await _datasource.validerPassword(passwordUser);
    } on DioException catch (e) {
      throw Exception(_extractMessage(e, 'Mot de passe invalide'));
    }
  }

  Future<Map<String, dynamic>> register({
    required String nomUser,
    required String prenomUser,
    required String emailUser,
    required String passwordUser,
    required String roleUser,
    String? numeroTelUser,
    String? idVille,
    String? idOperateur,
    String? bioUser,
    String? specialiteEnseignant,
    String? titreProfessionnelEnseignant,
    String? niveauApprenant,
    String? idEtablissement,
    List<Map<String, String>>? reseauxSociaux,
  }) async {
    try {
      final data = await _datasource.register(
        nomUser: nomUser,
        prenomUser: prenomUser,
        emailUser: emailUser,
        passwordUser: passwordUser,
        roleUser: roleUser,
        numeroTelUser: numeroTelUser,
        idVille: idVille,
        idOperateur: idOperateur,
        bioUser: bioUser,
        specialiteEnseignant: specialiteEnseignant,
        titreProfessionnelEnseignant: titreProfessionnelEnseignant,
        niveauApprenant: niveauApprenant,
        idEtablissement: idEtablissement,
        reseauxSociaux: reseauxSociaux,
      );
      return {
        'token': data['token'],
        'user': UserModel.fromJson(data['user']),
      };
    } on DioException catch (e) {
      throw Exception(_extractMessage(e, 'Erreur lors de l\'inscription'));
    }
  }

  // ── RESET PASSWORD ──

  Future<void> demanderResetPassword(String emailUser) async {
    try {
      await _datasource.demanderResetPassword(emailUser);
    } on DioException catch (e) {
      throw Exception(_extractMessage(e, 'Erreur lors de l\'envoi du code'));
    }
  }

  Future<void> verifierCodeReset({
    required String emailUser,
    required String code,
  }) async {
    try {
      await _datasource.verifierCodeReset(emailUser: emailUser, code: code);
    } on DioException catch (e) {
      throw Exception(_extractMessage(e, 'Code incorrect'));
    }
  }

  Future<void> reinitialiserPassword({
    required String emailUser,
    required String code,
    required String newPassword,
  }) async {
    try {
      await _datasource.reinitialiserPassword(
        emailUser: emailUser,
        code: code,
        newPassword: newPassword,
      );
    } on DioException catch (e) {
      throw Exception(_extractMessage(e, 'Erreur lors de la réinitialisation'));
    }
  }

  // ── VALIDER TOKEN ──

  Future<bool> validerToken(String token) async {
    try {
      await _datasource.validerToken(token);
      return true;
    } on DioException catch (e) {
      throw Exception(_extractMessage(e, 'Token invalide ou expiré'));
    }
  }
}
